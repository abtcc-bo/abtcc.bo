---
// Una sola página 404 para todo el sitio: en español, con acceso a los otros idiomas.
import Base from '../layouts/Base.astro';
import { IDIOMAS, MENU, ruta, t } from '../i18n';

const textos = t('es');
---

<Base idioma="es" titulo={`${textos.error404.titulo} · ${textos.sitio.sigla}`} alternos={{}} noIndexar>
	<h1>{textos.error404.titulo}</h1>
	<p>{textos.error404.texto}</p>
	<ul>
		{
			MENU.map((seccion) => (
				<li>
					<a href={ruta(seccion, 'es')}>{textos.nav[seccion]}</a>
				</li>
			))
		}
	</ul>
	<p><a href={ruta('inicio', 'es')}>{textos.error404.volver}</a></p>

	{
		IDIOMAS.filter((idioma) => idioma !== 'es').map((idioma) => (
			<p lang={idioma}>
				{t(idioma).error404.titulo}. <a href={ruta('inicio', idioma)}>{t(idioma).error404.volver}</a>
			</p>
		))
	}
</Base>
