---
// Genera todas las páginas HTML del sitio en los tres idiomas:
//  - Secciones fijas (SECCIONES en src/i18n/rutas.ts). Contenido, en orden de prioridad:
//      1. una vista propia registrada en VISTAS (recibe también la página de texto, si existe);
//      2. una página de texto en src/content/paginas/{idioma}/ con `clave` igual a la sección;
//      3. el aviso "en construcción", que no se indexa en Google.
//  - Detalle de cada evento público, en los idiomas en que tiene texto.
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { VISTAS } from '../vistas';
import DetalleEvento from '../vistas/DetalleEvento.astro';
import PaginaInstitucional from '../vistas/PaginaInstitucional.astro';
import Pendiente from '../vistas/Pendiente.astro';
import { obtenerEventosPublicos, paginaDeSeccion, type Evento } from '../lib/contenido';
import { IDIOMAS, PADRES, SECCIONES, cadenaDeSecciones, ruta, t, type Alternos, type Idioma, type Seccion } from '../i18n';

export async function getStaticPaths() {
	const secciones = await Promise.all(
		(Object.keys(SECCIONES) as Seccion[]).map(async (seccion) => {
			const paginas = Object.fromEntries(await Promise.all(IDIOMAS.map(async (idioma) => [idioma, await paginaDeSeccion(seccion, idioma)] as const)));
			// Idiomas en que la sección tiene contenido real: solo esos se anuncian a Google como versiones.
			const conContenido = IDIOMAS.filter((idioma) => VISTAS[seccion] || paginas[idioma]);
			const alternos: Alternos = Object.fromEntries(conContenido.map((idioma) => [idioma, ruta(seccion, idioma)]));
			return IDIOMAS.map((idioma) => ({
				params: { ruta: ruta(seccion, idioma).slice(1, -1) },
				props: { tipo: 'seccion' as const, idioma, seccion, pagina: paginas[idioma], alternos },
			}));
		}),
	);
	const eventos = await Promise.all(
		IDIOMAS.map(async (idioma) =>
			(await obtenerEventosPublicos(idioma)).map((evento) => ({
				params: { ruta: ruta('eventos', idioma, evento.slug).slice(1, -1) },
				props: { tipo: 'evento' as const, idioma, evento },
			})),
		),
	);
	return [...secciones.flat(), ...eventos.flat()];
}

type Props =
	| { tipo: 'seccion'; idioma: Idioma; seccion: Seccion; pagina?: Awaited<ReturnType<typeof paginaDeSeccion>>; alternos: Alternos }
	| { tipo: 'evento'; idioma: Idioma; evento: Evento };

const props = Astro.props;
const { idioma } = props;
const textos = t(idioma);

const migasHasta = (seccion: Seccion) => cadenaDeSecciones(seccion).map((s) => ({ nombre: textos.nav[s], href: ruta(s, idioma) }));

let imagenEvento: string | undefined;
if (props.tipo === 'evento' && props.evento.datos.imagen) {
	imagenEvento = (await getImage({ src: props.evento.datos.imagen, width: 1200 })).src;
}

const Vista = props.tipo === 'seccion' ? VISTAS[props.seccion] : undefined;
const pagina = props.tipo === 'seccion' ? props.pagina : undefined;
const enConstruccion = props.tipo === 'seccion' && !Vista && !pagina;
const subsecciones =
	props.tipo === 'seccion'
		? (Object.entries(PADRES) as [Seccion, Seccion][]).filter(([, padre]) => padre === props.seccion).map(([hija]) => ({ nombre: textos.nav[hija], href: ruta(hija, idioma) }))
		: [];

const nombre = props.tipo === 'evento' ? props.evento.texto.data.titulo : (pagina?.data.titulo ?? textos.nav[props.seccion]);
const titulo = props.tipo === 'seccion' && props.seccion === 'inicio' ? `${textos.sitio.sigla} · ${textos.sitio.nombre}` : `${nombre} · ${textos.sitio.sigla}`;
---

{
	props.tipo === 'seccion' ? (
		<Base
			idioma={idioma}
			titulo={titulo}
			descripcion={pagina?.data.descripcion}
			alternos={props.alternos}
			migas={migasHasta(props.seccion).slice(0, -1)}
			nombreEnMigas={props.seccion === 'inicio' ? undefined : nombre}
			noIndexar={props.seccion === 'socios' || enConstruccion}
		>
			{Vista ? (
				<Vista idioma={idioma} pagina={pagina} />
			) : pagina ? (
				<PaginaInstitucional pagina={pagina} subsecciones={subsecciones} />
			) : (
				<Pendiente idioma={idioma} seccion={props.seccion} alternos={props.alternos} />
			)}
		</Base>
	) : (
		<Base
			idioma={idioma}
			titulo={titulo}
			descripcion={props.evento.texto.data.resumen}
			alternos={props.evento.alternos}
			migas={migasHasta('eventos')}
			nombreEnMigas={nombre}
			imagen={imagenEvento}
		>
			<DetalleEvento evento={props.evento} idioma={idioma} />
		</Base>
	)
}
