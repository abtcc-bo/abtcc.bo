---
import { Image } from 'astro:assets';
import SelectorIdioma from './SelectorIdioma.astro';
import logo from '../assets/logo-encabezado.png';
import { MENU, hijasDe, ruta, t, type Alternos, type Idioma } from '../i18n';

interface Props {
	idioma: Idioma;
	alternos: Alternos;
}

const { idioma, alternos } = Astro.props;
const textos = t(idioma);
const actual = Astro.url.pathname;
---

<header class="encabezado">
	<div class="contenedor fila">
		<a class="logo" href={ruta('inicio', idioma)}>
			<Image src={logo} alt={textos.sitio.sigla} height={44} densities={[1, 2]} loading="eager" />
		</a>
		<button class="boton-menu" type="button" aria-expanded="false" aria-controls="panel-menu">{textos.nav.menu}</button>
		<div class="panel" id="panel-menu">
			<nav aria-label={textos.nav.principal}>
				<ul>
					{
						MENU.map((seccion) => {
							const href = ruta(seccion, idioma);
							const hijas = hijasDe(seccion);
							// Con subsecciones: desplegable con la página principal y sus subsecciones.
							if (hijas.length) {
								return (
									<li>
										<details class="desplegable">
											<summary class={actual.startsWith(href) ? 'actual' : undefined}>{textos.nav[seccion]}</summary>
											<ul class="lista-desplegable">
												{[seccion, ...hijas].map((s) => {
													const enlace = ruta(s, idioma);
													return (
														<li>
															<a href={enlace} aria-current={actual === enlace ? 'page' : undefined}>
																{textos.nav[s]}
															</a>
														</li>
													);
												})}
											</ul>
										</details>
									</li>
								);
							}
							return (
								<li>
									<a href={href} aria-current={actual.startsWith(href) ? 'page' : undefined}>
										{textos.nav[seccion]}
									</a>
								</li>
							);
						})
					}
				</ul>
			</nav>
			<SelectorIdioma idioma={idioma} alternos={alternos} />
			<a class="boton-socios" href={ruta('socios', idioma)}>{textos.nav.socios}</a>
		</div>
	</div>
</header>

<script>
	// Menú desplegable en celular. Sin JavaScript, el menú queda siempre visible.
	const boton = document.querySelector<HTMLButtonElement>('.boton-menu');
	boton?.addEventListener('click', () => {
		const abierto = boton.getAttribute('aria-expanded') === 'true';
		boton.setAttribute('aria-expanded', String(!abierto));
	});

	// Desplegables (<details>): en pantallas grandes con mouse se abren al pasar por encima;
	// se cierran al abrir otro, al hacer clic fuera o con Escape.
	const desplegables = [...document.querySelectorAll<HTMLDetailsElement>('.encabezado .desplegable')];
	const conMouse = matchMedia('(hover: hover) and (min-width: 48.01rem)');
	const abiertosPorMouse = new WeakSet<HTMLDetailsElement>();
	for (const desplegable of desplegables) {
		desplegable.addEventListener('mouseenter', () => {
			if (!conMouse.matches || desplegable.open) return;
			desplegable.open = true;
			abiertosPorMouse.add(desplegable);
		});
		desplegable.addEventListener('mouseleave', () => {
			if (conMouse.matches && abiertosPorMouse.has(desplegable)) desplegable.open = false;
		});
		// Un clic en un desplegable abierto por el mouse lo deja fijo en vez de cerrarlo.
		desplegable.querySelector('summary')?.addEventListener('click', (e) => {
			if (abiertosPorMouse.has(desplegable)) {
				e.preventDefault();
				abiertosPorMouse.delete(desplegable);
			}
		});
		desplegable.addEventListener('toggle', () => {
			if (!desplegable.open) {
				abiertosPorMouse.delete(desplegable);
				return;
			}
			for (const otro of desplegables) if (otro !== desplegable) otro.open = false;
		});
	}
	document.addEventListener('click', (e) => {
		for (const desplegable of desplegables) if (!desplegable.contains(e.target as Node)) desplegable.open = false;
	});

	document.addEventListener('keydown', (e) => {
		if (e.key !== 'Escape') return;
		const abierto = desplegables.find((d) => d.open);
		if (abierto) {
			abierto.open = false;
			abierto.querySelector('summary')?.focus();
		} else if (boton?.getAttribute('aria-expanded') === 'true') {
			boton.setAttribute('aria-expanded', 'false');
			boton.focus();
		}
	});
</script>

<style>
	.encabezado {
		border-bottom: 1px solid var(--color-borde);
	}
	.fila {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--espacio);
		padding-block: var(--espacio);
	}
	.logo {
		margin-right: auto;
		line-height: 0;
	}
	.logo img {
		height: 2.75rem;
		width: auto;
	}
	.panel {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--espacio);
	}
	nav > ul {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--espacio);
		list-style: none;
		margin: 0;
		padding: 0;
	}
	[aria-current='page'],
	.actual {
		font-weight: 700;
	}
	.boton-menu {
		display: none;
		min-height: 44px;
		padding-inline: 1rem;
		font: inherit;
	}

	@media (max-width: 48rem) {
		:global(.js) .boton-menu {
			display: block;
		}
		.panel {
			flex-basis: 100%;
			flex-direction: column;
			align-items: flex-start;
		}
		:global(.js) .boton-menu[aria-expanded='false'] + .panel {
			display: none;
		}
		nav > ul {
			flex-direction: column;
			align-items: flex-start;
			gap: 0;
		}
		.panel a {
			display: inline-block;
			min-height: 44px;
			padding-block: 0.6rem;
		}
	}
</style>
