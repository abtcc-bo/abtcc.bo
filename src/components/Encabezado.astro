---
import { Image } from 'astro:assets';
import SelectorIdioma from './SelectorIdioma.astro';
import logo from '../assets/logo-encabezado.png';
import { render } from 'astro:content';
import { obtenerEventosPublicos, paginaDeSeccion, yaPaso } from '../lib/contenido';
import { MENU, hijasDe, ruta, t, type Alternos, type Idioma, type Seccion } from '../i18n';

interface Props {
	idioma: Idioma;
	alternos: Alternos;
}

const { idioma, alternos } = Astro.props;
const textos = t(idioma);
const actual = Astro.url.pathname;

/** Opción de un submenú. `fin`: el navegador la oculta cuando el evento ya pasó (páginas generadas antes). */
interface Opcion {
	nombre: string;
	href: string;
	fin?: string;
}

// Submenús: la sección principal va siempre primero; después, estas opciones.
const submenus: Partial<Record<Seccion, Opcion[]>> = {};
for (const seccion of MENU) {
	const hijas = hijasDe(seccion);
	if (hijas.length) submenus[seccion] = hijas.map((hija) => ({ nombre: textos.nav[hija], href: ruta(hija, idioma) }));
}
// Formación y eventos: los próximos (hasta 4) y el archivo de realizados.
const eventos = await obtenerEventosPublicos(idioma);
const proximos = eventos.filter((e) => !yaPaso(e)).slice(0, 4);
submenus.eventos = [
	...proximos.map((e) => ({ nombre: e.texto.data.titulo, href: ruta('eventos', idioma, e.slug), fin: (e.datos.fin ?? e.datos.inicio).toISOString() })),
	...(eventos.length > proximos.length ? [{ nombre: textos.eventos.realizados, href: `${ruta('eventos', idioma)}#titulo-realizados` }] : []),
];
// Membresía: los títulos de su página (Categorías, Beneficios, Cuota...).
const paginaMembresia = await paginaDeSeccion('membresia', idioma);
if (paginaMembresia) {
	const { headings } = await render(paginaMembresia);
	submenus.membresia = headings.filter((h) => h.depth === 2).map((h) => ({ nombre: h.text, href: `${ruta('membresia', idioma)}#${h.slug}` }));
}
---

<header class="encabezado">
	<div class="contenedor fila">
		<a class="logo" href={ruta('inicio', idioma)}>
			<Image src={logo} alt={textos.sitio.sigla} height={44} densities={[1, 2]} loading="eager" />
		</a>
		<button class="boton-menu" type="button" aria-expanded="false" aria-controls="panel-menu">{textos.nav.menu}</button>
		<div class="panel" id="panel-menu">
			<nav aria-label={textos.nav.principal}>
				<ul>
					{
						MENU.map((seccion) => {
							const href = ruta(seccion, idioma);
							const opciones = submenus[seccion] ?? [];
							// Con submenú: desplegable con la página principal y sus opciones.
							if (opciones.length) {
								return (
									<li>
										<details class="desplegable">
											<summary class={actual.startsWith(href) ? 'actual' : undefined}>{textos.nav[seccion]}</summary>
											<ul class="lista-desplegable">
												{[{ nombre: textos.nav[seccion], href }, ...opciones].map((opcion, i) => (
													<li class={i === 0 ? 'principal' : undefined} data-fin={opcion.fin}>
														<a href={opcion.href} aria-current={actual === opcion.href ? 'page' : undefined}>
															{opcion.nombre}
														</a>
													</li>
												))}
											</ul>
										</details>
									</li>
								);
							}
							return (
								<li>
									<a href={href} aria-current={actual.startsWith(href) ? 'page' : undefined}>
										{textos.nav[seccion]}
									</a>
								</li>
							);
						})
					}
				</ul>
			</nav>
			<SelectorIdioma idioma={idioma} alternos={alternos} />
			<a class="boton-socios" href={ruta('socios', idioma)}>{textos.nav.socios}</a>
		</div>
	</div>
</header>

<script>
	// Menú desplegable en celular. Sin JavaScript, el menú queda siempre visible.
	const boton = document.querySelector<HTMLButtonElement>('.boton-menu');
	boton?.addEventListener('click', () => {
		const abierto = boton.getAttribute('aria-expanded') === 'true';
		boton.setAttribute('aria-expanded', String(!abierto));
	});

	// Eventos del submenú que ya terminaron (si la página se generó antes): se ocultan.
	for (const opcion of document.querySelectorAll<HTMLElement>('.encabezado [data-fin]')) {
		if (new Date(opcion.dataset.fin!) < new Date()) opcion.hidden = true;
	}

	// Desplegables (<details>): en pantallas grandes con mouse se abren al pasar por encima;
	// se cierran al abrir otro, al hacer clic fuera o con Escape.
	const desplegables = [...document.querySelectorAll<HTMLDetailsElement>('.encabezado .desplegable')];
	const conMouse = matchMedia('(hover: hover) and (min-width: 48.01rem)');
	const abiertosPorMouse = new WeakSet<HTMLDetailsElement>();
	for (const desplegable of desplegables) {
		desplegable.addEventListener('mouseenter', () => {
			if (!conMouse.matches || desplegable.open) return;
			desplegable.open = true;
			abiertosPorMouse.add(desplegable);
		});
		desplegable.addEventListener('mouseleave', () => {
			if (conMouse.matches && abiertosPorMouse.has(desplegable)) desplegable.open = false;
		});
		// Un clic en un desplegable abierto por el mouse lo deja fijo en vez de cerrarlo.
		desplegable.querySelector('summary')?.addEventListener('click', (e) => {
			if (abiertosPorMouse.has(desplegable)) {
				e.preventDefault();
				abiertosPorMouse.delete(desplegable);
			}
		});
		desplegable.addEventListener('toggle', () => {
			if (!desplegable.open) {
				abiertosPorMouse.delete(desplegable);
				return;
			}
			for (const otro of desplegables) if (otro !== desplegable) otro.open = false;
		});
	}
	document.addEventListener('click', (e) => {
		for (const desplegable of desplegables) if (!desplegable.contains(e.target as Node)) desplegable.open = false;
	});

	document.addEventListener('keydown', (e) => {
		if (e.key !== 'Escape') return;
		const abierto = desplegables.find((d) => d.open);
		if (abierto) {
			abierto.open = false;
			abierto.querySelector('summary')?.focus();
		} else if (boton?.getAttribute('aria-expanded') === 'true') {
			boton.setAttribute('aria-expanded', 'false');
			boton.focus();
		}
	});
</script>

<style>
	.encabezado {
		position: sticky;
		top: 0;
		z-index: 20;
		background: rgb(255 255 255 / 0.96);
		border-bottom: 1px solid var(--color-borde);
		backdrop-filter: blur(6px);
	}
	/* Franja con los tres colores del logo. */
	.encabezado::before {
		content: '';
		display: block;
		height: 4px;
		background: var(--franja-tricolor);
	}
	.fila {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--espacio);
		padding-block: 0.6rem;
	}
	.logo {
		margin-right: auto;
		line-height: 0;
	}
	.logo img {
		height: 2.75rem;
		width: auto;
	}
	.panel {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--espacio);
	}
	nav > ul {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--espacio);
		list-style: none;
		margin: 0;
		padding: 0;
	}
	nav a,
	nav summary,
	.panel :global(.selector-idioma summary) {
		color: var(--color-texto);
		text-decoration: none;
		font-size: 1rem;
		font-weight: 500;
	}
	nav > ul > li > a,
	nav summary {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		border-bottom: 2px solid transparent;
	}
	nav > ul > li > a:hover,
	nav summary:hover {
		color: var(--color-acento);
	}
	[aria-current='page'],
	.actual {
		color: var(--color-acento);
		border-bottom-color: var(--color-acento) !important;
	}
	.boton-socios {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding-inline: 1rem;
		border: 1px solid var(--color-acento);
		border-radius: var(--radio);
		color: var(--color-acento);
		font-size: 0.9375rem;
		font-weight: 600;
		text-decoration: none;
	}
	.boton-socios:hover {
		background: var(--color-acento);
		color: #fff;
	}
	.boton-menu {
		display: none;
		min-height: 44px;
		padding-inline: 1rem;
		font: inherit;
		font-weight: 600;
		color: var(--color-titulos);
		background: var(--color-superficie);
		border: 1px solid var(--color-borde);
		border-radius: var(--radio);
	}

	@media (max-width: 48rem) {
		:global(.js) .boton-menu {
			display: block;
		}
		.panel {
			flex-basis: 100%;
			flex-direction: column;
			align-items: flex-start;
			gap: 0.25rem;
			max-height: calc(100dvh - 5rem);
			overflow-y: auto;
			padding-bottom: var(--espacio);
		}
		:global(.js) .boton-menu[aria-expanded='false'] + .panel {
			display: none;
		}
		nav > ul {
			flex-direction: column;
			align-items: flex-start;
			gap: 0;
		}
		.panel a {
			display: inline-block;
			min-height: 44px;
			padding-block: 0.6rem;
		}
	}
</style>
