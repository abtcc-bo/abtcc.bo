---
import { ORGANIZACION } from '../datos/organizacion';
import { IDIOMAS, MENU, MENU_LEGAL, ruta, t, type Idioma } from '../i18n';

interface Props {
	idioma: Idioma;
}

const { idioma } = Astro.props;
const textos = t(idioma);
const anio = new Date().getFullYear();
// [PENDIENTE fase 2: suscripción al boletín]
---

<footer class="pie">
	<div class="contenedor columnas">
		<section class="marca">
			<span class="puntos" aria-hidden="true"></span>
			<p class="nombre">{textos.sitio.nombre}</p>
			<p class="suave">{ORGANIZACION.pais}</p>
		</section>

		<nav aria-labelledby="pie-explorar">
			<h2 id="pie-explorar">{textos.pie.explorar}</h2>
			<ul>
				{
					MENU.filter((s) => s !== 'contacto').map((seccion) => (
						<li>
							<a href={ruta(seccion, idioma)}>{textos.nav[seccion]}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<section aria-labelledby="pie-contacto">
			<h2 id="pie-contacto">{textos.pie.contacto}</h2>
			<ul>
				<li>{ORGANIZACION.correo ? <a class="correo" href={`mailto:${ORGANIZACION.correo}`}>{ORGANIZACION.correo}</a> : textos.comun.pendiente}</li>
				<li><a href={`${ruta('contacto', idioma)}#formulario`}>{textos.pie.formulario}</a></li>
				{
					ORGANIZACION.redes.length ? (
						ORGANIZACION.redes.map((red) => (
							<li>
								<a href={red.url} rel="noopener">
									{red.nombre}
								</a>
							</li>
						))
					) : (
						<li class="suave">
							{textos.pie.redes}: {textos.comun.pendiente}
						</li>
					)
				}
			</ul>
		</section>

		<nav aria-labelledby="pie-legal">
			<h2 id="pie-legal">{textos.pie.legal}</h2>
			<ul>
				{
					MENU_LEGAL.map((seccion) => (
						<li>
							<a href={ruta(seccion, idioma)}>{textos.nav[seccion]}</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
	<div class="contenedor final">
		<p>© {anio} {textos.sitio.sigla} · {textos.sitio.afiliacion}</p>
		<ul class="idiomas">
			{
				IDIOMAS.map((otro) => (
					<li>
						<a href={ruta('inicio', otro)} hreflang={otro} lang={otro} aria-current={otro === idioma ? 'true' : undefined}>
							{t(otro).idioma.nombre}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>

<style>
	.pie {
		background: var(--color-oscuro-profundo);
		color: var(--color-oscuro-texto);
		font-size: 0.875rem;
	}
	/* Franja con los tres colores del logo. */
	.pie::before {
		content: '';
		display: block;
		height: 4px;
		background: var(--franja-tricolor);
	}
	.columnas {
		display: grid;
		gap: 2rem;
		grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
		padding-block: 3.5rem 2.5rem;
	}
	h2 {
		margin: 0 0 1rem;
		font-family: var(--fuente-texto);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-dorado-claro);
	}
	p {
		margin: 0;
	}
	ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li + li {
		margin-top: 0.55rem;
	}
	a {
		color: #fff;
		text-decoration: none;
	}
	a:hover {
		color: var(--color-dorado-claro);
	}
	.correo {
		text-decoration: underline;
		text-decoration-color: rgb(255 255 255 / 0.4);
	}
	.puntos {
		display: block;
		width: 2.6rem;
		height: 0.6rem;
		margin-bottom: 1rem;
		background:
			radial-gradient(circle, var(--logo-rojo) 0.25rem, transparent 0.27rem) 0 50% / 0.85rem 0.6rem no-repeat,
			radial-gradient(circle, var(--logo-amarillo) 0.25rem, transparent 0.27rem) 0.85rem 50% / 0.85rem 0.6rem no-repeat,
			radial-gradient(circle, var(--logo-verde) 0.25rem, transparent 0.27rem) 1.7rem 50% / 0.85rem 0.6rem no-repeat;
	}
	.nombre {
		max-width: 16rem;
		margin-bottom: 0.5rem;
		font-family: var(--fuente-titulos);
		font-size: 1.25rem;
		line-height: 1.25;
		color: #fff;
	}
	.suave {
		color: var(--color-oscuro-suave);
	}
	.final {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1.25rem 1.75rem;
		border-top: 1px solid rgb(255 255 255 / 0.08);
		font-size: 0.75rem;
		color: var(--color-oscuro-suave);
	}
	.idiomas {
		display: flex;
		gap: 0.4rem;
	}
	.idiomas li + li {
		margin-top: 0;
	}
	.idiomas li + li::before {
		content: '·';
		margin-right: 0.4rem;
	}
	.idiomas a {
		color: var(--color-oscuro-suave);
	}
	.idiomas [aria-current] {
		color: #fff;
	}
	:focus-visible {
		outline-color: var(--color-dorado-claro);
	}
</style>
