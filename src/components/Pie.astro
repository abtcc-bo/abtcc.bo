---
import { ORGANIZACION } from '../datos/organizacion';
import { MENU_LEGAL, ruta, t, type Idioma } from '../i18n';

interface Props {
	idioma: Idioma;
}

const { idioma } = Astro.props;
const textos = t(idioma);
const anio = new Date().getFullYear();
// [PENDIENTE fase 2: suscripción al boletín]
---

<footer class="pie">
	<div class="contenedor columnas">
		<section>
			<p class="nombre">{textos.sitio.nombre} ({textos.sitio.sigla})</p>
			<p>{ORGANIZACION.pais}</p>
		</section>

		<section>
			<h2>{textos.pie.contacto}</h2>
			<p>
				{ORGANIZACION.correo ? <a href={`mailto:${ORGANIZACION.correo}`}>{ORGANIZACION.correo}</a> : textos.comun.pendiente}
			</p>
			<p><a href={ruta('contacto', idioma)}>{textos.nav.contacto}</a></p>
		</section>

		<section>
			<h2>{textos.pie.redes}</h2>
			{
				ORGANIZACION.redes.length ? (
					<ul>
						{ORGANIZACION.redes.map((red) => (
							<li>
								<a href={red.url} rel="noopener">
									{red.nombre}
								</a>
							</li>
						))}
					</ul>
				) : (
					<p>{textos.comun.pendiente}</p>
				)
			}
		</section>

		<section>
			<h2>{textos.pie.legal}</h2>
			<ul>
				{
					MENU_LEGAL.map((seccion) => (
						<li>
							<a href={ruta(seccion, idioma)}>{textos.nav[seccion]}</a>
						</li>
					))
				}
			</ul>
		</section>
	</div>
	<p class="contenedor derechos">© {anio} {textos.sitio.sigla}. {textos.pie.derechos}</p>
</footer>

<style>
	.pie {
		background: var(--color-oscuro);
		color: var(--color-oscuro-texto);
		font-size: 0.9375rem;
	}
	/* Franja con los tres colores del logo. */
	.pie::before {
		content: '';
		display: block;
		height: 4px;
		background: var(--franja-tricolor);
	}
	.columnas {
		display: grid;
		gap: calc(var(--espacio) * 2);
		grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
		padding-block: calc(var(--espacio) * 3) calc(var(--espacio) * 2);
	}
	h2 {
		margin: 0 0 0.75rem;
		font-family: var(--fuente-texto);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #aab3c5;
	}
	p,
	ul {
		margin: 0 0 0.4rem;
	}
	ul {
		list-style: none;
		padding: 0;
	}
	li + li {
		margin-top: 0.4rem;
	}
	a {
		color: #fff;
		text-decoration-color: rgb(255 255 255 / 0.35);
	}
	a:hover {
		color: #fff;
		text-decoration-color: #fff;
	}
	.nombre {
		font-family: var(--fuente-titulos);
		font-size: 1.375rem;
		font-weight: 600;
		line-height: 1.25;
		color: #fff;
	}
	.derechos {
		margin: 0;
		padding-block: var(--espacio) calc(var(--espacio) * 1.5);
		border-top: 1px solid rgb(255 255 255 / 0.12);
		font-size: 0.875rem;
		color: #aab3c5;
	}
	:focus-visible {
		outline-color: var(--logo-amarillo);
	}
</style>
