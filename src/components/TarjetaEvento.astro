---
// Resumen de un evento para portada y listados. Si el evento tiene afiche, se muestra arriba.
import { Image } from 'astro:assets';
import { ruta, t, type Idioma } from '../i18n';
import { fechaDelEvento, inscripcionAbierta } from '../lib/eventos';
import type { Evento } from '../lib/contenido';

interface Props {
	evento: Evento;
	idioma: Idioma;
	/** Nivel del título según dónde se muestre la tarjeta. */
	nivel?: 'h2' | 'h3';
}

const { evento, idioma, nivel: Titulo = 'h3' } = Astro.props;
const textos = t(idioma).eventos;
const { datos } = evento;
const href = ruta('eventos', idioma, evento.slug);
const abierta = inscripcionAbierta(evento);
---

<article
	class="tarjeta-evento"
	data-tipo={datos.tipo}
	data-modalidad={datos.modalidad}
	data-fin={(datos.fin ?? datos.inicio).toISOString()}
>
	{datos.imagen && <Image src={datos.imagen} alt="" widths={[400, 800]} sizes="(max-width: 48rem) 100vw, 24rem" class="afiche" />}
	<p class="etiquetas">
		<span>{textos.tipos[datos.tipo]}</span>
		{datos.modalidad && <span>{textos.modalidades[datos.modalidad]}</span>}
		{datos.estado !== 'programado' && <strong class={`estado estado-${datos.estado}`}>{textos.estados[datos.estado]}</strong>}
	</p>
	<Titulo><a href={href}>{evento.texto.data.titulo}</a></Titulo>
	<p class="fecha">
		<time datetime={datos.inicio.toISOString()}>{fechaDelEvento(evento, idioma)}</time>
		{datos.lugar && <span> · {datos.lugar.ciudad}</span>}
	</p>
	<p class="resumen">{evento.texto.data.resumen}</p>
	<p class="acciones">
		{abierta && datos.inscripcion && <a class="boton" href={datos.inscripcion.url} rel="noopener">{t(idioma).comun.inscribirme}</a>}
		<a href={href}>{textos.verDetalle} <span aria-hidden="true">→</span><span class="visualmente-oculto">: {evento.texto.data.titulo}</span></a>
	</p>
</article>

<style>
	.tarjeta-evento {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 1.25rem;
		background: var(--color-superficie);
		border: 1px solid var(--color-borde);
		border-radius: var(--radio);
		transition: box-shadow 0.2s, transform 0.2s;
	}
	.tarjeta-evento:hover {
		box-shadow: var(--sombra);
		transform: translateY(-2px);
	}
	/* Decorativo (alt vacío): el título del evento ya está en la tarjeta. Ocupa el ancho completo de la tarjeta. */
	.afiche {
		display: block;
		width: calc(100% + 2.5rem);
		max-width: none;
		height: auto;
		aspect-ratio: 1;
		object-fit: cover;
		margin: -1.25rem -1.25rem 1.25rem;
		border-radius: var(--radio) var(--radio) 0 0;
		background: var(--color-fondo);
	}
	.etiquetas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
	}
	.etiquetas > * {
		padding: 0.1rem 0.55rem;
		border-radius: 999px;
		background: var(--color-acento-suave);
		color: var(--color-acento-hover);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.etiquetas .estado-cancelado,
	.etiquetas .estado-pospuesto {
		background: #fdecec;
		color: #a40000;
	}
	h2,
	h3 {
		margin: 0.75rem 0 0.5rem;
		font-size: 1.375rem;
	}
	h2 a,
	h3 a {
		color: var(--color-titulos);
		text-decoration: none;
	}
	h2 a:hover,
	h3 a:hover {
		color: var(--color-acento);
	}
	.fecha {
		margin: 0;
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--color-acento-hover);
	}
	.resumen {
		color: var(--color-texto-suave);
		font-size: 1rem;
	}
	.acciones {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--espacio);
		margin: auto 0 0;
		padding-top: 0.5rem;
	}
	.acciones a:not(.boton) {
		font-weight: 600;
		text-decoration: none;
	}
</style>
