---
// Resumen de un evento para portada y listados.
import { formatearRangoFechas, ruta, t, type Idioma } from '../i18n';
import { inscripcionAbierta } from '../lib/eventos';
import type { Evento } from '../lib/contenido';

interface Props {
	evento: Evento;
	idioma: Idioma;
	/** Nivel del título según dónde se muestre la tarjeta. */
	nivel?: 'h2' | 'h3';
}

const { evento, idioma, nivel: Titulo = 'h3' } = Astro.props;
const textos = t(idioma).eventos;
const { datos } = evento;
const href = ruta('eventos', idioma, evento.slug);
const abierta = inscripcionAbierta(evento);
---

<article
	class="tarjeta-evento"
	data-tipo={datos.tipo}
	data-modalidad={datos.modalidad}
	data-fin={(datos.fin ?? datos.inicio).toISOString()}
>
	<p class="etiquetas">
		<span>{textos.tipos[datos.tipo]}</span>
		<span>{textos.modalidades[datos.modalidad]}</span>
		{datos.estado !== 'programado' && <strong class={`estado estado-${datos.estado}`}>{textos.estados[datos.estado]}</strong>}
	</p>
	<Titulo><a href={href}>{evento.texto.data.titulo}</a></Titulo>
	<p class="fecha">
		<time datetime={datos.inicio.toISOString()}>{formatearRangoFechas(datos.inicio, datos.fin, idioma)}</time>
		{datos.lugar && <span> · {datos.lugar.ciudad}</span>}
	</p>
	<p>{evento.texto.data.resumen}</p>
	<p class="acciones">
		{abierta && datos.inscripcion && <a class="boton" href={datos.inscripcion.url} rel="noopener">{t(idioma).comun.inscribirme}</a>}
		<a href={href}>{textos.verDetalle}<span class="visualmente-oculto">: {evento.texto.data.titulo}</span></a>
	</p>
</article>

<style>
	.tarjeta-evento {
		border: 1px solid var(--color-borde);
		padding: var(--espacio);
	}
	.etiquetas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		font-size: 0.875rem;
		color: var(--color-texto-suave);
	}
	.estado-cancelado,
	.estado-pospuesto {
		color: #a40000;
	}
	h2,
	h3 {
		margin: 0.5rem 0;
	}
	.fecha {
		font-weight: 700;
		margin: 0;
	}
	.acciones {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--espacio);
	}
</style>
