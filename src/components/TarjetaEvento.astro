---
// Resumen de un evento para portada y listados. Si el evento tiene afiche, se muestra arriba.
import { Image } from 'astro:assets';
import { LOCALE_INTL, ZONA_HORARIA, ruta, t, type Idioma } from '../i18n';
import { fechaDelEvento, inscripcionAbierta } from '../lib/eventos';
import type { Evento } from '../lib/contenido';

interface Props {
	evento: Evento;
	idioma: Idioma;
	/** Nivel del título según dónde se muestre la tarjeta. */
	nivel?: 'h2' | 'h3';
}

const { evento, idioma, nivel: Titulo = 'h3' } = Astro.props;
const textos = t(idioma).eventos;
const { datos } = evento;
const href = ruta('eventos', idioma, evento.slug);
const abierta = inscripcionAbierta(evento);
// Cabecera de la tarjeta: mes abreviado y año ("Dic 2026").
const mes = new Intl.DateTimeFormat(LOCALE_INTL[idioma], { timeZone: ZONA_HORARIA, month: 'short' }).format(datos.inicio).replace('.', '');
const anio = new Intl.DateTimeFormat(LOCALE_INTL[idioma], { timeZone: ZONA_HORARIA, year: 'numeric' }).format(datos.inicio);
---

<article
	class="tarjeta-evento"
	data-tipo={datos.tipo}
	data-modalidad={datos.modalidad}
	data-fin={(datos.fin ?? datos.inicio).toISOString()}
>
	<div class:list={['cabecera', datos.imagen ? 'con-imagen' : datos.tipo === 'congreso' ? 'verde' : 'azul']}>
		{datos.imagen && <Image src={datos.imagen} alt="" widths={[400, 800]} sizes="(max-width: 48rem) 100vw, 24rem" class="imagen" />}
		<p class="mes" aria-hidden="true">
			<span class="mes-nombre">{mes}</span>
			<span class="anio">{anio}</span>
		</p>
		<span class="tipo">{textos.tipos[datos.tipo]}</span>
	</div>
	<div class="cuerpo">
		{datos.estado !== 'programado' && <p class={`estado estado-${datos.estado}`}>{textos.estados[datos.estado]}</p>}
		<Titulo><a href={href}>{evento.texto.data.titulo}</a></Titulo>
		<p class="resumen">{evento.texto.data.resumen}</p>
		<p class="fecha">
			<time datetime={datos.inicio.toISOString()}>{fechaDelEvento(evento, idioma)}</time>
			{datos.lugar && <span> · {datos.lugar.ciudad}</span>}
			{datos.modalidad && <span> · {textos.modalidades[datos.modalidad]}</span>}
		</p>
		<p class="acciones">
			{abierta && datos.inscripcion && <a class="boton" href={datos.inscripcion.url} rel="noopener">{t(idioma).comun.inscribirme}</a>}
			<a class="ver" href={href}>
				{textos.verDetalle} <span class="flecha" aria-hidden="true">→</span>
				<span class="visualmente-oculto">: {evento.texto.data.titulo}</span>
			</a>
		</p>
	</div>
</article>

<style>
	.tarjeta-evento {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		background: var(--color-tarjeta);
		border: 1px solid var(--color-borde);
		border-radius: var(--radio);
		transition:
			box-shadow 0.3s,
			transform 0.3s;
	}
	.tarjeta-evento:hover {
		box-shadow: var(--sombra);
		transform: translateY(-4px);
	}
	/* Cabecera de color con el mes; si el evento tiene imagen, la imagen hace de fondo. */
	.cabecera {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		min-height: 6.5rem;
		padding: 1.1rem 1.25rem;
		color: #fff;
		isolation: isolate;
	}
	.verde {
		background: var(--color-verde);
	}
	.azul {
		background: var(--color-oscuro);
	}
	.con-imagen {
		min-height: 11rem;
		background: var(--color-oscuro);
	}
	.imagen {
		position: absolute;
		inset: 0;
		z-index: -1;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s;
	}
	/* Sombra para que el mes se lea sobre la foto. */
	.con-imagen::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(180deg, transparent 35%, rgb(10 18 35 / 0.75));
	}
	.tarjeta-evento:hover .imagen {
		transform: scale(1.05);
	}
	.mes {
		display: grid;
		margin: 0;
		line-height: 1;
	}
	.mes-nombre {
		font-family: var(--fuente-titulos);
		font-size: 2.4rem;
		text-transform: capitalize;
	}
	.anio {
		margin-top: 0.35rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		color: var(--color-dorado-claro);
	}
	.tipo {
		padding: 0.15rem 0.6rem;
		border: 1px solid rgb(255 255 255 / 0.5);
		border-radius: 999px;
		font-size: 0.625rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.cuerpo {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 1.25rem;
	}
	.estado {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		color: #a40000;
	}
	h2,
	h3 {
		margin: 0 0 0.5rem;
		font-size: 1.6rem;
	}
	h2 a,
	h3 a {
		color: var(--color-titulos);
		text-decoration: none;
	}
	h2 a:hover,
	h3 a:hover {
		color: var(--color-acento);
	}
	.resumen {
		margin: 0 0 0.75rem;
		font-size: 0.9375rem;
		color: var(--color-texto-suave);
	}
	.fecha {
		margin: 0;
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--color-dorado);
	}
	.acciones {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--espacio);
		margin: auto 0 0;
		padding-top: 1rem;
	}
	.ver {
		font-size: 0.9375rem;
		font-weight: 600;
		text-decoration: none;
	}
</style>
