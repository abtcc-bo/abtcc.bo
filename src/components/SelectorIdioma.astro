---
// Lista desplegable de idiomas. Lleva a la misma página en el otro idioma; si no existe en ese idioma, a su inicio.
// Usa <details>: funciona sin JavaScript. El comportamiento común de los desplegables está en Encabezado.astro.
import { IDIOMAS, ruta, t, type Alternos, type Idioma } from '../i18n';

interface Props {
	idioma: Idioma;
	alternos: Alternos;
}

const { idioma, alternos } = Astro.props;
const textos = t(idioma).idioma;
---

<details class="desplegable selector-idioma">
	<summary>
		<span class="visualmente-oculto">{textos.selector}: </span>{textos.nombre}
	</summary>
	<ul class="lista-desplegable">
		{
			IDIOMAS.map((otro) => {
				const textosOtro = t(otro).idioma;
				if (otro === idioma) {
					return (
						<li>
							<span aria-current="true">{textosOtro.nombre}</span>
						</li>
					);
				}
				const destino = alternos[otro];
				return (
					<li>
						<a href={destino ?? ruta('inicio', otro)} hreflang={otro} lang={otro} title={destino ? undefined : textosOtro.noDisponible}>
							{textosOtro.nombre}
						</a>
					</li>
				);
			})
		}
	</ul>
</details>

<style>
	.selector-idioma .lista-desplegable {
		right: 0;
		left: auto;
	}
	[aria-current] {
		font-weight: 700;
	}
</style>
