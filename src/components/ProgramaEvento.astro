---
// Programa de un evento (campo `programa` del texto del evento), como línea de tiempo: cada día abre con una esfera
// con su número; cada actividad tiene su hora a la izquierda, un punto de color sobre la línea y una tarjeta con el
// tipo ("Conferencia 3"), el título, el retrato de quien expone y su país. Las pausas van en una línea discreta.
// Diseño "III Jornadas Navideñas — rediseño".
import BanderaPais from './BanderaPais.astro';
import Icono from './Icono.astro';
import RetratoPonente from './RetratoPonente.astro';
import { LOCALE_INTL, ZONA_HORARIA, formato, t, type Idioma } from '../i18n';
import { fechaDelDia, horasDelDia, nombreDelDia, type Actividad } from '../lib/eventos';
import type { Evento } from '../lib/contenido';

interface Props {
	evento: Evento;
	idioma: Idioma;
}

const { evento, idioma } = Astro.props;
const ev = t(idioma).eventos;
const dias = evento.texto.data.programa;
const COLORES = ['rojo', 'amarillo', 'verde'] as const;
const numeroDia = (fecha: string) => new Intl.DateTimeFormat(LOCALE_INTL[idioma], { timeZone: ZONA_HORARIA, day: 'numeric' }).format(fechaDelDia(fecha));

// Numera las conferencias en orden ("Conferencia 1", "Conferencia 2"...) y reparte colores entre las actividades.
let conferencia = 0;
let color = 0;
const filas = dias.map((dia) =>
	dia.actividades.map((a: Actividad) => {
		if (a.tipo === 'pausa') return { a, color: undefined, rotulo: undefined };
		const rotulo = a.tipo === 'conferencia' ? formato(ev.conferenciaN, { n: ++conferencia }) : ev.tiposActividad[a.tipo];
		return { a, color: COLORES[color++ % 3], rotulo };
	}),
);
---

<section id="programa" class:list={['programa', { navidad: evento.datos.tema === 'navidad' }]} aria-labelledby="titulo-programa">
	<p class="antetitulo">{ev.programa}</p>
	<h2 id="titulo-programa">{ev.agendaTitulo} <em>{ev.agendaCursiva}</em></h2>
	<p class="nota">
		<Icono nombre="reloj" />
		{ev.horasBolivia}
	</p>

	{
		dias.map((dia, i) => (
			<div class="dia">
				<h3>
					<span class:list={['numero', i % 2 === 0 ? 'esfera-roja' : 'esfera-verde']} aria-hidden="true">
						{numeroDia(dia.fecha)}
					</span>
					<span>
						{nombreDelDia(dia, idioma)}
						<small>
							{dia.titulo} · {horasDelDia(dia)}
						</small>
					</span>
				</h3>
				<ol>
					{filas[i].map(({ a, color, rotulo }) =>
						a.tipo === 'pausa' ? (
							<li class="pausa">
								<p class="hora">
									{a.inicio} – {a.fin}
								</p>
								<p class="texto-pausa">
									<Icono nombre="cafe" />
									{a.titulo ?? ev.tiposActividad.pausa}
								</p>
							</li>
						) : (
							<li class:list={['actividad', `punto-${color}`]}>
								<p class="hora">
									{a.inicio} – {a.fin}
								</p>
								<div class:list={['tarjeta-actividad', `cinta-${color}`]}>
									<p class:list={['rotulo', `rotulo-${color}`]}>{rotulo}</p>
									{a.titulo && <p class="titulo">{a.titulo}</p>}
									{a.ponente && (
										<p class="ponente">
											<span class="cuelga">
												<RetratoPonente actividad={a} tamano="mediano" color={color} />
											</span>
											<span>
												<strong>{a.ponente}</strong>
												{a.pais && <BanderaPais codigo={a.pais} idioma={idioma} />}
											</span>
										</p>
									)}
								</div>
							</li>
						),
					)}
				</ol>
			</div>
		))
	}
</section>

<style>
	.programa {
		max-width: 56rem;
		margin-inline: auto;
	}
	h2 {
		margin: 0.75rem 0 1rem;
	}
	h2 em {
		color: #8a1a2c;
	}
	.nota {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 2.5rem;
		padding: 0.4rem 1rem;
		border-radius: 999px;
		background: #efe9dc;
		font-family: var(--fuente-interfaz);
		font-size: 0.875rem;
		color: var(--color-texto-suave);
	}
	.nota :global(.icono) {
		width: 1.1rem;
		height: 1.1rem;
	}
	.dia + .dia {
		margin-top: 3rem;
	}
	/* Encabezado del día: esfera con el número del día, nombre del día y horario. */
	h3 {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin: 0 0 1.5rem;
		font-size: clamp(1.5rem, 1.25rem + 0.9vw, 1.9rem);
	}
	h3 small {
		display: block;
		font-family: var(--fuente-interfaz);
		font-size: 0.875rem;
		font-weight: 400;
		color: var(--color-texto-suave);
	}
	.numero {
		position: relative;
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 50%;
		font-size: 1.5rem;
		font-weight: 600;
		color: #fff;
		box-shadow: inset 0 -5px 10px rgb(0 0 0 / 0.2);
	}
	/* Tapa dorada de la esfera. */
	.numero::before {
		content: '';
		position: absolute;
		top: -0.35rem;
		width: 0.8rem;
		height: 0.45rem;
		border-radius: 2px;
		background: var(--color-dorado-claro);
	}
	.esfera-roja {
		background: radial-gradient(circle at 35% 30%, #ff8a8a, #e3151b 50%, #8f0b10);
	}
	.esfera-verde {
		background: radial-gradient(circle at 35% 30%, #7ad99a, #0c9439 50%, #04551c);
	}
	ol {
		position: relative;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* La línea de tiempo pasa entre la hora y las tarjetas. */
	ol::before {
		content: '';
		position: absolute;
		top: 0.5rem;
		bottom: 0.5rem;
		left: 9.6rem;
		width: 1px;
		background: #ddd3c0;
	}
	li {
		position: relative;
		display: grid;
		grid-template-columns: 8.5rem 1fr;
		gap: 2.5rem;
		align-items: start;
	}
	li + li {
		margin-top: 0.85rem;
	}
	li p {
		margin: 0;
	}
	/* Punto de color sobre la línea. */
	li::before {
		content: '';
		position: absolute;
		top: 0.45rem;
		left: calc(9.6rem - 0.4rem);
		width: 0.8rem;
		height: 0.8rem;
		border-radius: 50%;
		background: #d9cfba;
	}
	.punto-rojo::before {
		background: #c8202a;
	}
	.punto-amarillo::before {
		background: #e8b40c;
	}
	.punto-verde::before {
		background: #0c9439;
	}
	.hora {
		padding-top: 0.15rem;
		font-family: var(--fuente-interfaz);
		font-size: 0.9375rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		color: var(--color-titulos);
	}
	.tarjeta-actividad {
		padding: 1.15rem 1.4rem;
		border: 1px solid #ece4d3;
		border-radius: 0.85rem;
		background: #fffdf8;
		transition:
			box-shadow 0.3s,
			transform 0.3s;
	}
	.tarjeta-actividad:hover {
		transform: translateY(-2px);
		box-shadow: var(--sombra);
	}
	.rotulo {
		font-family: var(--fuente-interfaz);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.rotulo-rojo {
		color: #b81d26;
	}
	.rotulo-amarillo {
		color: #9a6b00;
	}
	.rotulo-verde {
		color: #0b7a31;
	}
	.titulo {
		margin-top: 0.3rem;
		font-family: var(--fuente-titulos);
		font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.5rem);
		line-height: 1.3;
		color: var(--color-titulos);
	}
	.ponente {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		margin-top: 0.8rem;
	}
	.ponente > span {
		display: grid;
		gap: 0.1rem;
	}
	.ponente strong {
		font-family: var(--fuente-interfaz);
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--color-titulos);
	}
	.ponente :global(.pais) {
		font-family: var(--fuente-interfaz);
		font-size: 0.8125rem;
		color: var(--color-texto-suave);
	}
	.pausa .hora {
		font-weight: 500;
		color: var(--color-texto-suave);
	}
	.texto-pausa {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--fuente-titulos);
		font-style: italic;
		color: var(--color-texto-suave);
	}
	.texto-pausa :global(.icono) {
		width: 1.1rem;
		height: 1.1rem;
		color: var(--color-dorado);
	}

	/* ---------- Navidad: sobre la banda verde pino, con más color ---------- */
	.navidad {
		position: relative;
		z-index: 1;
	}
	.navidad h2 em {
		color: var(--color-dorado-claro);
	}
	.navidad .nota {
		background: rgb(255 255 255 / 0.1);
		color: var(--texto-banda);
	}
	.navidad h3 small,
	.navidad .pausa .hora {
		color: var(--texto-banda-suave);
	}
	.navidad ol::before {
		width: 0;
		border-left: 2px dashed rgb(235 186 60 / 0.5);
		background: none;
	}
	.navidad li::before {
		box-shadow: 0 0 0 3px #0d3b27, 0 0 10px rgb(255 255 255 / 0.35);
	}
	.navidad .hora {
		color: var(--color-dorado-claro);
		font-weight: 700;
	}
	.navidad .tarjeta-actividad {
		border: 0;
		border-top: 6px solid var(--color-dorado-claro);
		border-radius: 1.5rem 0.75rem 0.75rem 0.75rem;
		box-shadow: 0 14px 30px rgb(0 0 0 / 0.25);
	}
	.navidad .tarjeta-actividad:hover {
		transform: translateY(-3px);
		box-shadow: 0 20px 40px rgb(0 0 0 / 0.3);
	}
	.navidad .cinta-rojo {
		border-top-color: #c8202a;
	}
	.navidad .cinta-amarillo {
		border-top-color: #e8b40c;
	}
	.navidad .cinta-verde {
		border-top-color: #0c9439;
	}
	/* Rótulo como píldora de color. */
	.navidad .rotulo {
		display: inline-block;
		padding: 0.2rem 0.75rem;
		border-radius: 999px;
		color: #fff;
	}
	.navidad .rotulo-rojo {
		background: #b81d26;
	}
	.navidad .rotulo-amarillo {
		background: var(--color-dorado-claro);
		color: #3a2600;
	}
	.navidad .rotulo-verde {
		background: #0b7a31;
	}
	/* Foto más grande, colgada como esfera: hilo y tapa dorados encima. */
	.navidad .cuelga {
		position: relative;
		display: block;
		margin-top: 0.9rem;
	}
	.navidad .cuelga::before {
		content: '';
		position: absolute;
		bottom: 100%;
		left: 50%;
		width: 0.9rem;
		height: 0.5rem;
		translate: -50% 0;
		border-radius: 3px 3px 1px 1px;
		background: linear-gradient(90deg, #a87f17, #f3d27a, #a87f17);
	}
	.navidad .cuelga::after {
		content: '';
		position: absolute;
		bottom: calc(100% + 0.5rem);
		left: 50%;
		width: 2px;
		height: 0.6rem;
		translate: -50% 0;
		background: var(--color-dorado-claro);
	}
	.navidad .cuelga :global(.retrato.mediano) {
		width: 4.75rem;
		height: 4.75rem;
		transition: rotate 0.4s;
		transform-origin: 50% -0.8rem;
	}
	.navidad .tarjeta-actividad:hover .cuelga :global(.retrato) {
		rotate: -6deg;
	}
	.navidad .ponente strong {
		font-size: 1rem;
	}
	/* Pausas: píldora punteada dorada. */
	.navidad .texto-pausa {
		justify-self: start;
		padding: 0.4rem 1.1rem;
		border: 2px dashed rgb(235 186 60 / 0.55);
		border-radius: 999px;
		font-style: normal;
		font-weight: 500;
		color: #f6e3b0;
	}
	.navidad .texto-pausa :global(.icono) {
		color: var(--color-dorado-claro);
	}
	@media (prefers-reduced-motion: reduce) {
		.navidad .cuelga :global(.retrato.mediano) {
			transition: none;
		}
	}

	@media (max-width: 40rem) {
		ol::before {
			left: 0.4rem;
		}
		li {
			grid-template-columns: 1fr;
			gap: 0.35rem;
			padding-left: 1.75rem;
		}
		li::before {
			left: 0;
		}
	}
</style>
