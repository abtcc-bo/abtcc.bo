---
// Programa de un evento (campo `programa` del texto del evento): un bloque por día con sus actividades, horas de
// Bolivia, ponentes y país. Las pausas (descanso, almuerzo) van en una línea discreta. Con `tema: navidad`, cada
// actividad es una tarjeta con acento vino y el día lleva las tres esferas del logo.
import BanderaPais from './BanderaPais.astro';
import RetratoPonente from './RetratoPonente.astro';
import { formatearFecha, t, type Idioma } from '../i18n';
import { fechaDelDia, type Actividad } from '../lib/eventos';
import type { Evento } from '../lib/contenido';

interface Props {
	evento: Evento;
	idioma: Idioma;
}

const { evento, idioma } = Astro.props;
const ev = t(idioma).eventos;
const dias = evento.texto.data.programa;
// "Viernes, 4 de diciembre" (con mayúscula inicial: en español el día viene en minúscula).
const nombreDia = (fecha: string) => {
	const texto = formatearFecha(fechaDelDia(fecha), idioma, { weekday: 'long', day: 'numeric', month: 'long' });
	return texto.charAt(0).toUpperCase() + texto.slice(1);
};
const conPonente = (a: Actividad) => a.tipo !== 'pausa';
const navidad = evento.datos.tema === 'navidad';
---

<section id="programa" class:list={['programa', { navidad }]} aria-labelledby="titulo-programa">
	<p class="antetitulo">{ev.programa}</p>
	<h2 id="titulo-programa">{evento.texto.data.titulo}</h2>
	<p class="nota">{ev.horasBolivia}</p>

	{
		dias.map((dia) => (
			<div class="dia">
				<h3>
					<span class="nombre-dia">
						{navidad && <span class="puntos-dia" aria-hidden="true" />}
						{nombreDia(dia.fecha)}
					</span>
					<span class="titulo-dia">{dia.titulo}</span>
				</h3>
				<ol>
					{dia.actividades.map((a) =>
						conPonente(a) ? (
							<li class:list={['actividad', a.tipo]}>
								<p class="hora">
									<time>{a.inicio}</time>–<time>{a.fin}</time>
								</p>
								<div class="detalle">
									{a.tipo !== 'conferencia' && <p class="tipo">{ev.tiposActividad[a.tipo]}</p>}
									{a.titulo && <p class="titulo">{a.titulo}</p>}
									{a.ponente && (
										<p class="ponente">
											<RetratoPonente actividad={a} tamano="mediano" />
											<span>
												<strong>{a.ponente}</strong>
												{a.pais && <BanderaPais codigo={a.pais} idioma={idioma} />}
											</span>
										</p>
									)}
								</div>
							</li>
						) : (
							<li class="pausa">
								<p class="hora">
									<time>{a.inicio}</time>–<time>{a.fin}</time>
								</p>
								<p>{a.titulo ?? ev.tiposActividad.pausa}</p>
							</li>
						),
					)}
				</ol>
			</div>
		))
	}
</section>

<style>
	.programa h2 {
		margin-top: 0.75rem;
	}
	.nota {
		margin: 0 0 2rem;
		color: var(--color-texto-suave);
	}
	.dia + .dia {
		margin-top: 2.5rem;
	}
	/* Encabezado del día: cinta de color con el nombre del día y el tipo de jornada. */
	h3 {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		margin: 0 0 0.75rem;
		padding: 0.9rem 1.5rem;
		border-radius: 999px;
		background: var(--color-oscuro);
		font-size: clamp(1.4rem, 1.2rem + 0.8vw, 1.75rem);
		color: #fff;
	}
	.titulo-dia {
		font-family: var(--fuente-interfaz);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-dorado-claro);
	}
	ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		display: grid;
		grid-template-columns: 9rem 1fr;
		gap: 0.25rem 1.75rem;
		padding: 1.4rem 1.5rem;
		border-bottom: 1px solid var(--color-division);
	}
	li p {
		margin: 0;
	}
	.hora {
		font-family: var(--fuente-interfaz);
		font-size: 1.05rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		color: var(--color-acento);
	}
	.tipo {
		margin-bottom: 0.2rem;
		font-family: var(--fuente-interfaz);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-dorado);
	}
	.titulo {
		font-family: var(--fuente-titulos);
		font-size: clamp(1.3rem, 1.1rem + 0.7vw, 1.65rem);
		line-height: 1.3;
		color: var(--color-titulos);
	}
	.ponente {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		margin-top: 0.8rem;
		font-size: 1.05rem;
	}
	.ponente > span {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.15rem 0.75rem;
	}
	.ponente :global(.pais) {
		font-family: var(--fuente-interfaz);
		font-size: 0.875rem;
		color: var(--color-texto-suave);
	}
	/* El taller destaca: fondo cálido y borde dorado. */
	.taller {
		border: 1px solid var(--color-dorado-claro);
		border-radius: var(--radio);
		background: #fbf3dc;
	}
	.bienvenida .titulo,
	.cierre .titulo {
		font-size: 1.25rem;
	}
	.pausa {
		padding-block: 0.6rem;
		background: rgb(255 255 255 / 0.4);
		font-style: italic;
		color: var(--color-texto-suave);
	}
	.pausa .hora {
		color: var(--color-texto-suave);
		font-style: normal;
	}

	/* ---------- Navidad ---------- */
	.navidad h3 {
		background: linear-gradient(160deg, #8a1a2c, #561020);
		box-shadow: 0 8px 20px rgb(86 16 32 / 0.25);
	}
	.puntos-dia {
		display: inline-block;
		width: 2.6rem;
		height: 0.8rem;
		margin-right: 0.6rem;
		vertical-align: middle;
		background:
			radial-gradient(circle at 40% 35%, #ff8a8a 0 0.08rem, #e3151b 0.12rem 0.32rem, transparent 0.34rem) 0 50% / 0.87rem 0.8rem no-repeat,
			radial-gradient(circle at 40% 35%, #fff2a8 0 0.08rem, #f6c400 0.12rem 0.32rem, transparent 0.34rem) 0.87rem 50% / 0.87rem 0.8rem no-repeat,
			radial-gradient(circle at 40% 35%, #7ad99a 0 0.08rem, #0c9439 0.12rem 0.32rem, transparent 0.34rem) 1.74rem 50% / 0.87rem 0.8rem no-repeat;
	}
	.navidad li {
		margin-top: 0.75rem;
		border: 1px solid #ecd9b0;
		border-left: 4px solid #8a1a2c;
		border-radius: var(--radio);
		background: #fffdf8;
		box-shadow: 0 2px 10px rgb(86 16 32 / 0.06);
	}
	.navidad .hora {
		color: #8a1a2c;
	}
	.navidad .taller {
		border-color: var(--color-dorado-claro);
		border-left-color: var(--color-dorado-claro);
		background: linear-gradient(135deg, #fdf3d6, #fffaf0);
	}
	.navidad .pausa {
		border-style: dashed;
		border-left: 1px dashed #d9b98a;
		background: transparent;
		box-shadow: none;
	}
	.navidad .pausa > p:last-child::before {
		content: '✦ ';
		color: var(--color-dorado-claro);
		font-style: normal;
	}

	@media (max-width: 36rem) {
		li {
			grid-template-columns: 1fr;
			padding-inline: 0.75rem;
		}
		h3 {
			border-radius: var(--radio);
		}
	}
</style>
