---
// Preguntas frecuentes en acordeón (campo `preguntas` de la página de la sección). Hecho con <details>: funciona sin
// JavaScript; en navegadores recientes la respuesta se despliega con una transición suave.
import { ruta, t, type Idioma } from '../i18n';

interface Props {
	idioma: Idioma;
	preguntas: { pregunta: string; respuesta: string }[];
}

const { idioma, preguntas } = Astro.props;
const v = t(idioma).preguntas;
---

{
	preguntas.length > 0 && (
		<section id="preguntas" class="banda banda-clara preguntas" aria-labelledby="titulo-preguntas">
			<div>
				<p class="antetitulo">{v.antetitulo}</p>
				<h2 id="titulo-preguntas">{v.titulo}</h2>
				<p class="otra-duda">
					{v.otraDuda}{' '}
					<a class="enlace-accion" href={ruta('contacto', idioma)}>
						{v.escribenos} <span class="flecha" aria-hidden="true">→</span>
					</a>
				</p>
			</div>
			<div class="lista">
				{preguntas.map((p) => (
					<details>
						<summary>
							<span>{p.pregunta}</span>
							<span class="signo" aria-hidden="true" />
						</summary>
						<p>{p.respuesta}</p>
					</details>
				))}
			</div>
		</section>
	)
}

<style>
	.preguntas {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
		gap: 2rem 4rem;
		align-items: start;
	}
	h2 {
		margin-top: 0.75rem;
	}
	.otra-duda {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 1rem;
		margin: 1.5rem 0 0;
		color: var(--color-texto-suave);
	}
	.lista {
		border-top: 1px solid var(--color-division);
	}
	details {
		border-bottom: 1px solid var(--color-division);
	}
	summary {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		min-height: 44px;
		padding-block: 1.25rem;
		cursor: pointer;
		list-style: none;
		font-family: var(--fuente-titulos);
		font-size: 1.4rem;
		line-height: 1.3;
		color: var(--color-titulos);
		transition: color 0.2s;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary:hover {
		color: var(--color-acento);
	}
	/* Signo "+" en un círculo, que gira y se vuelve "×" al abrir. */
	.signo {
		position: relative;
		flex-shrink: 0;
		width: 2rem;
		height: 2rem;
		border: 1px solid var(--color-division);
		border-radius: 50%;
		transition:
			transform 0.3s,
			background-color 0.3s,
			border-color 0.3s;
	}
	.signo::before,
	.signo::after {
		content: '';
		position: absolute;
		inset: 50% auto auto 50%;
		width: 0.75rem;
		height: 1.5px;
		background: var(--color-acento);
		translate: -50% -50%;
		transition: background-color 0.3s;
	}
	.signo::after {
		rotate: 90deg;
	}
	details[open] .signo {
		transform: rotate(45deg);
		background: var(--color-acento);
		border-color: var(--color-acento);
	}
	details[open] .signo::before,
	details[open] .signo::after {
		background: #fff;
	}
	details p {
		max-width: 40rem;
		margin: 0;
		padding: 0 3.5rem 1.5rem 0;
		color: var(--color-texto-suave);
	}
	/* Despliegue suave (navegadores recientes; en los demás se abre al instante). */
	details::details-content {
		block-size: 0;
		overflow: clip;
		transition:
			block-size 0.35s ease,
			content-visibility 0.35s allow-discrete;
	}
	details[open]::details-content {
		block-size: auto;
	}

	@media (max-width: 52rem) {
		.preguntas {
			grid-template-columns: 1fr;
		}
		details p {
			padding-right: 0;
		}
	}
</style>
