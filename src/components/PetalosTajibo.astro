---
// Pétalos de tajibo que caen despacio, meciéndose (decoración de los eventos con `tema: tajibo`). Va dentro de un
// contenedor con `position: relative` y `overflow: hidden`; no tapa clics. Cada pétalo tiene su posición, tamaño,
// tono y ritmo por nth-child (sin estilos en línea: la CSP los bloquea). Con "reducir movimiento" no se muestran.
interface Props {
	/** Cuántos pétalos (máximo 14). */
	cantidad?: number;
}

const { cantidad = 12 } = Astro.props;
const petalos = Array.from({ length: Math.min(cantidad, 14) }, (_, i) => i);
---

<div class="petalos" aria-hidden="true">
	{
		petalos.map(() => (
			<span class="petalo">
				<svg viewBox="0 0 20 28" focusable="false">
					<path d="M10 1C15.5 6 17 13 14.5 20 13 24.5 11 27 10 27S7 24.5 5.5 20C3 13 4.5 6 10 1z" />
					<path class="vena" d="M10 5v18" />
				</svg>
			</span>
		))
	}
</div>

<style>
	.petalos {
		position: absolute;
		inset: 0;
		z-index: 1;
		overflow: hidden;
		pointer-events: none;
	}
	.petalo {
		position: absolute;
		top: -3rem;
		left: 50%;
		width: 1rem;
		animation:
			caer 16s linear infinite,
			mecer 4s ease-in-out infinite alternate;
	}
	svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
		filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.18));
		animation: girar 6s ease-in-out infinite alternate;
	}
	path {
		fill: #ff8fb5;
	}
	.vena {
		fill: none;
		stroke: rgb(156 28 79 / 0.35);
		stroke-width: 1;
		stroke-linecap: round;
	}
	/* Posición, tamaño, tono y ritmo de cada pétalo. */
	.petalo:nth-child(1) { left: 6%; width: 1.1rem; animation-duration: 17s, 4.2s; animation-delay: -3s, 0s; }
	.petalo:nth-child(2) { left: 14%; width: 0.8rem; animation-duration: 21s, 3.6s; animation-delay: -11s, -1s; }
	.petalo:nth-child(3) { left: 23%; width: 1.25rem; animation-duration: 15s, 4.8s; animation-delay: -7s, -2s; }
	.petalo:nth-child(4) { left: 31%; width: 0.9rem; animation-duration: 19s, 3.9s; animation-delay: -15s, -0.5s; }
	.petalo:nth-child(5) { left: 40%; width: 1rem; animation-duration: 23s, 4.4s; animation-delay: -1s, -3s; }
	.petalo:nth-child(6) { left: 49%; width: 0.75rem; animation-duration: 18s, 3.4s; animation-delay: -9s, -1.5s; }
	.petalo:nth-child(7) { left: 57%; width: 1.15rem; animation-duration: 16s, 5s; animation-delay: -13s, -2.5s; }
	.petalo:nth-child(8) { left: 65%; width: 0.85rem; animation-duration: 22s, 3.7s; animation-delay: -5s, 0s; }
	.petalo:nth-child(9) { left: 73%; width: 1.3rem; animation-duration: 14s, 4.6s; animation-delay: -10s, -1s; }
	.petalo:nth-child(10) { left: 81%; width: 0.9rem; animation-duration: 20s, 4s; animation-delay: -2s, -3.5s; }
	.petalo:nth-child(11) { left: 89%; width: 1.05rem; animation-duration: 17.5s, 3.8s; animation-delay: -16s, -2s; }
	.petalo:nth-child(12) { left: 96%; width: 0.8rem; animation-duration: 24s, 4.3s; animation-delay: -8s, -0.5s; }
	.petalo:nth-child(13) { left: 36%; width: 0.7rem; animation-duration: 26s, 3.5s; animation-delay: -19s, -1s; }
	.petalo:nth-child(14) { left: 69%; width: 0.7rem; animation-duration: 25s, 4.1s; animation-delay: -21s, -2s; }
	.petalo:nth-child(3n) path:first-child { fill: #e64980; }
	.petalo:nth-child(4n + 1) path:first-child { fill: #ffb3cd; }
	.petalo:nth-child(2n) svg { animation-duration: 7.5s; }

	/* `top` en % es relativo al alto del contenedor: el pétalo cruza toda la cabecera, sea cual sea su alto. */
	@keyframes caer {
		from { top: -3rem; }
		to { top: 105%; }
	}
	@keyframes mecer {
		from { margin-left: -1.75rem; }
		to { margin-left: 1.75rem; }
	}
	@keyframes girar {
		from { transform: rotate(-35deg) rotateY(0deg); }
		to { transform: rotate(40deg) rotateY(160deg); }
	}
	@media (prefers-reduced-motion: reduce) {
		.petalos {
			display: none;
		}
	}
</style>
