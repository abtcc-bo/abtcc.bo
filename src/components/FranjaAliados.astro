---
// Franja de la portada con los logos de las páginas amigas y aliados; cada uno lleva a su tarjeta en la página de
// aliados. Los logos van en círculos blancos y se agrandan un poco al pasar el mouse.
import { Image } from 'astro:assets';
import { obtenerAliados } from '../lib/contenido';
import { ruta, t, type Idioma } from '../i18n';

interface Props {
	idioma: Idioma;
}

const { idioma } = Astro.props;
const a = t(idioma).aliados;
const aliados = await obtenerAliados();
const pagina = ruta('aliados', idioma);
---

{
	aliados.length > 0 && (
		<section class="banda banda-clara aliados" aria-labelledby="titulo-aliados">
			<div class="cabecera-seccion">
				<div>
					<p class="antetitulo">{a.antetitulo}</p>
					<h2 id="titulo-aliados">{a.titulo}</h2>
					<p class="texto">{a.texto}</p>
				</div>
				<a class="enlace-accion" href={pagina}>
					{a.verTodos} <span class="flecha" aria-hidden="true">→</span>
				</a>
			</div>
			<ul class="logos">
				{aliados.map((aliado) => (
					<li>
						<a href={`${pagina}#${aliado.id}`}>
							<span class:list={['circulo', { foto: aliado.data.imagen_es_foto }]}>
								<Image src={aliado.data.imagen} alt="" widths={[160, 320]} sizes="7rem" />
							</span>
							<span class="nombre">{aliado.data.nombre}</span>
						</a>
					</li>
				))}
			</ul>
		</section>
	)
}

<style>
	.texto {
		max-width: 36rem;
		margin: 0.75rem 0 0;
		color: var(--color-texto-suave);
	}
	.logos {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.5rem 2.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.logos a {
		display: grid;
		justify-items: center;
		gap: 0.75rem;
		width: 8.5rem;
		text-align: center;
		text-decoration: none;
	}
	.circulo {
		display: grid;
		place-items: center;
		width: 7rem;
		height: 7rem;
		overflow: hidden;
		border: 1px solid var(--color-borde);
		border-radius: 50%;
		background: #fff;
		box-shadow: var(--sombra);
		transition:
			transform 0.3s,
			box-shadow 0.3s;
	}
	.circulo img {
		display: block;
		width: 82%;
		height: 82%;
		object-fit: contain;
	}
	.foto img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.logos a:hover .circulo {
		transform: translateY(-4px) scale(1.05);
		box-shadow: var(--sombra-grande);
	}
	.nombre {
		font-family: var(--fuente-interfaz);
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--color-titulos);
	}
</style>
