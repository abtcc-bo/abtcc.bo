---
// Cabecera de la página de un evento (slot "cabecera" de Base.astro): tipo y modalidad, título, lema, fecha,
// modalidad y zona horaria, y los botones para inscribirse, ver el programa o consultar por WhatsApp.
// A la derecha, el afiche. Con `tema: navidad` (diseño "III Jornadas Navideñas — rediseño"): guirnalda arriba,
// título en dos líneas con la última palabra en dorado y, en lugar del afiche, la entrada (TicketEvento).
import { Image } from 'astro:assets';
import AdornoNavidad from './AdornoNavidad.astro';
import Guirnalda from './Guirnalda.astro';
import TicketEvento from './TicketEvento.astro';
import Icono from './Icono.astro';
import { formato, t, type Idioma } from '../i18n';
import { contactoWhatsapp, fechaDelEvento, inscripcionAbierta } from '../lib/eventos';
import type { Evento } from '../lib/contenido';

interface Props {
	evento: Evento;
	idioma: Idioma;
}

const { evento, idioma } = Astro.props;
const textos = t(idioma);
const ev = textos.eventos;
const { datos } = evento;
const { titulo, lema, programa } = evento.texto.data;
const palabras = titulo.trim().split(' ');
const ultima = palabras.pop();
const whatsapp = datos.whatsapp && contactoWhatsapp(datos.whatsapp, formato(ev.mensajeWhatsapp, { evento: titulo }));
const lugar = datos.modalidad !== 'online' && datos.lugar ? ` · ${datos.lugar.ciudad}` : '';
const navidad = datos.tema === 'navidad';
const conTicket = navidad && !datos.por_confirmar && inscripcionAbierta(evento);
---

{navidad && <Guirnalda />}
<div class:list={['cabecera-evento', { 'con-visual': datos.imagen || datos.tema, navidad }]}>
	<div class="texto">
		<p class="antetitulo">
			{ev.tipos[datos.tipo]}
			{datos.modalidad && <> · {ev.modalidades[datos.modalidad]}</>}
		</p>
		<h1>
			{palabras.length > 0 && <>{palabras.join(' ')} </>}<span class="cursiva">{ultima}</span>
		</h1>
		{lema && <p class="lema">{lema}</p>}
		{datos.estado !== 'programado' && <p class="aviso-estado" role="status">{ev.estados[datos.estado]}</p>}
		<ul class="datos-evento">
			<li>
				<Icono nombre="calendario" />
				{fechaDelEvento(evento, idioma)}
			</li>
			{
				datos.modalidad && (
					<li>
						<Icono nombre={datos.modalidad === 'presencial' ? 'globo' : 'pantalla'} />
						{ev.modalidades[datos.modalidad]}
						{lugar}
					</li>
				)
			}
			{
				!datos.por_confirmar && (
					<li>
						<Icono nombre="reloj" />
						{textos.hora.zonaBolivia}
					</li>
				)
			}
		</ul>
		<p class="acciones">
			{
				inscripcionAbierta(evento) && datos.inscripcion && (
					<a class="boton boton-dorado" href={datos.inscripcion.url} rel="noopener">
						{textos.comun.inscribirme} <span class="flecha" aria-hidden="true">→</span>
					</a>
				)
			}
			{
				programa.length > 0 && (
					<a class="boton boton-contorno" href="#programa">
						{ev.verPrograma}
					</a>
				)
			}
			{
				whatsapp && (
					<a class="whatsapp" href={whatsapp.url} rel="noopener">
						<Icono nombre="dialogo" />
						<span>
							{ev.whatsapp} <strong>{whatsapp.visible}</strong>
						</span>
					</a>
				)
			}
		</p>
	</div>
	{
		conTicket ? (
			<div class="visual ticket-lugar">
				<TicketEvento evento={evento} idioma={idioma} />
			</div>
		) : datos.imagen ? (
			<div class="visual afiche">
				<Image src={datos.imagen} alt={titulo} widths={[400, 800]} sizes="(max-width: 56rem) 80vw, 24rem" loading="eager" />
			</div>
		) : (
			datos.tema === 'navidad' && (
				<div class="visual">
					<AdornoNavidad />
				</div>
			)
		)
	}
</div>

<style>
	.cabecera-evento {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 2rem 4rem;
		align-items: center;
		padding-top: 1rem;
	}
	.con-visual {
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
	}
	h1 {
		margin: 1rem 0 0.75rem;
		font-size: clamp(2.6rem, 1.6rem + 3.8vw, 4.25rem);
		line-height: 1.04;
	}
	.lema {
		max-width: 36rem;
		margin: 0 0 1.5rem;
		font-family: var(--fuente-titulos);
		font-size: clamp(1.25rem, 1.05rem + 0.8vw, 1.6rem);
		font-style: italic;
		line-height: 1.35;
		color: var(--color-dorado-claro);
	}
	.aviso-estado {
		display: inline-block;
		margin: 0 0 1rem;
		padding: 0.4rem 1rem;
		border: 2px solid currentColor;
		border-radius: 999px;
		font-family: var(--fuente-interfaz);
		font-weight: 700;
	}
	.datos-evento {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-family: var(--fuente-interfaz);
		font-size: 0.9375rem;
		color: var(--texto-banda);
	}
	.datos-evento li {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.datos-evento :global(.icono) {
		color: var(--color-dorado-claro);
	}
	.acciones {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
		margin: 2rem 0 0;
	}
	.whatsapp {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--fuente-interfaz);
		font-size: 0.9375rem;
		text-decoration: none;
	}
	.whatsapp :global(.icono) {
		color: var(--color-dorado-claro);
	}
	.whatsapp:hover span {
		text-decoration: underline;
	}
	.visual {
		justify-self: center;
		width: 100%;
		max-width: 22rem;
	}
	.afiche img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radio);
		box-shadow: var(--sombra-grande);
		background: #fff;
	}

	/* ---------- Navidad ---------- */
	.navidad .antetitulo::before {
		content: '★';
		width: auto;
		height: auto;
		background: none;
		color: var(--color-dorado-claro);
	}
	.navidad h1 {
		font-size: clamp(3rem, 1.8rem + 4.6vw, 5.25rem);
		font-weight: 600;
	}
	.navidad h1 .cursiva {
		display: block;
		color: var(--color-dorado-claro);
	}
	.navidad .datos-evento li {
		padding: 0.4rem 0.9rem;
		border: 1px solid rgb(255 255 255 / 0.3);
		border-radius: 999px;
		background: rgb(255 255 255 / 0.06);
	}
	.ticket-lugar {
		max-width: 24rem;
		margin-top: 2rem;
	}

	@media (max-width: 56rem) {
		.con-visual {
			grid-template-columns: 1fr;
		}
		.visual {
			justify-self: start;
			max-width: 16rem;
		}
	}
</style>
