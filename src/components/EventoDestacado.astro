---
// Banda de la portada con el próximo evento destacado (`destacado: true`) y una cuenta regresiva.
//  - Con fecha exacta: días, horas, minutos y segundos, actualizados cada segundo.
//  - Con fecha por confirmar (`por_confirmar`): "Faltan unos N meses", sin reloj.
import { Image } from 'astro:assets';
import { formato, ruta, t, type Idioma } from '../i18n';
import { fechaDelEvento } from '../lib/eventos';
import type { Evento } from '../lib/contenido';

interface Props {
	evento: Evento;
	idioma: Idioma;
}

const { evento, idioma } = Astro.props;
const textos = t(idioma);
const d = textos.destacado;
const { datos } = evento;
const { titulo, resumen } = evento.texto.data;
const href = ruta('eventos', idioma, evento.slug);

const restanteMs = Math.max(0, datos.inicio.getTime() - Date.now());
const DIA = 86_400_000;
const meses = Math.round(restanteMs / (30.44 * DIA));
const partes = [
	{ clave: 'dias', valor: Math.floor(restanteMs / DIA), nombre: d.dias },
	{ clave: 'horas', valor: Math.floor((restanteMs % DIA) / 3_600_000), nombre: d.horas },
	{ clave: 'minutos', valor: Math.floor((restanteMs % 3_600_000) / 60_000), nombre: d.minutos },
	{ clave: 'segundos', valor: Math.floor((restanteMs % 60_000) / 1000), nombre: d.segundos },
];
---

<section class="destacado banda" aria-labelledby="titulo-destacado">
	<div class="contenido">
		{datos.imagen && <Image src={datos.imagen} alt="" widths={[320, 640]} sizes="(max-width: 48rem) 70vw, 20rem" class="afiche" />}
		<div class="texto">
			<p class="antetitulo">{d.etiqueta}</p>
			<h2 id="titulo-destacado"><a href={href}>{titulo}</a></h2>
			<p class="fecha">
				{fechaDelEvento(evento, idioma)}
				{datos.lugar && <> · {datos.lugar.ciudad}</>}
			</p>
			<p class="resumen">{resumen}</p>

			{
				datos.por_confirmar ? (
					<p class="faltan-aprox">{meses <= 1 ? d.menosDeUnMes : formato(d.faltanMeses, { n: meses })}</p>
				) : (
					<div class="reloj" data-cuenta-regresiva data-inicio={datos.inicio.toISOString()}>
						<p class="visualmente-oculto">{d.faltan}</p>
						<ul role="timer" aria-live="off">
							{partes.map((p) => (
								<li>
									<span class="numero" data-parte={p.clave}>
										{String(p.valor).padStart(2, '0')}
									</span>
									<span class="unidad">{p.nombre}</span>
								</li>
							))}
						</ul>
					</div>
				)
			}

			<p class="acciones">
				<a class="boton" href={href}>{d.verEvento}</a>
			</p>
		</div>
	</div>
</section>

<script>
	for (const reloj of document.querySelectorAll<HTMLElement>('[data-cuenta-regresiva]')) {
		const inicio = Date.parse(reloj.dataset.inicio!);
		const campo = (clave: string) => reloj.querySelector<HTMLElement>(`[data-parte="${clave}"]`)!;
		const actualizar = () => {
			const ms = Math.max(0, inicio - Date.now());
			const valores = {
				dias: Math.floor(ms / 86_400_000),
				horas: Math.floor((ms % 86_400_000) / 3_600_000),
				minutos: Math.floor((ms % 3_600_000) / 60_000),
				segundos: Math.floor((ms % 60_000) / 1000),
			};
			for (const [clave, valor] of Object.entries(valores)) campo(clave).textContent = String(valor).padStart(2, '0');
			if (ms === 0) clearInterval(intervalo);
		};
		const intervalo = setInterval(actualizar, 1000);
		actualizar();
	}
</script>

<style>
	/* Banda oscura que contrasta con el resto de la portada. */
	.destacado {
		background:
			radial-gradient(circle at 85% 20%, rgb(252 222 88 / 0.18), transparent 40%),
			radial-gradient(circle at 10% 90%, rgb(3 127 54 / 0.35), transparent 45%),
			var(--color-oscuro);
		color: var(--color-oscuro-texto);
		/* Franja con los tres colores del logo arriba. */
		border-top: 4px solid;
		border-image: var(--franja-tricolor) 1;
	}
	.contenido {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: clamp(1.5rem, 4vw, 3.5rem);
		align-items: center;
	}
	.afiche {
		width: clamp(12rem, 24vw, 20rem);
		height: auto;
		border-radius: var(--radio);
		box-shadow: 0 20px 50px rgb(0 0 0 / 0.35);
		transform: rotate(-2deg);
	}
	.antetitulo {
		color: #c9d1e3;
	}
	h2 {
		margin: 0.75rem 0 0.5rem;
		font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem);
	}
	h2 a {
		color: #fff;
		text-decoration: none;
	}
	h2 a:hover {
		text-decoration: underline;
	}
	.fecha {
		margin: 0;
		font-weight: 600;
		color: var(--logo-amarillo);
	}
	.resumen {
		max-width: 38rem;
		color: #c9d1e3;
	}
	.faltan-aprox {
		display: inline-block;
		margin: 0.5rem 0 0;
		padding: 0.5rem 1rem;
		border: 1px solid rgb(255 255 255 / 0.2);
		border-radius: 999px;
		font-weight: 600;
		color: #fff;
	}
	.reloj ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	.reloj li {
		display: grid;
		justify-items: center;
		min-width: 4.5rem;
		padding: 0.6rem 0.5rem;
		border: 1px solid rgb(255 255 255 / 0.15);
		border-radius: var(--radio);
		background: rgb(255 255 255 / 0.06);
	}
	.numero {
		font-family: var(--fuente-titulos);
		font-size: 2.25rem;
		font-weight: 600;
		line-height: 1;
		color: #fff;
		font-variant-numeric: tabular-nums;
	}
	.unidad {
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #aab3c5;
	}
	.acciones {
		margin: 1.5rem 0 0;
	}
	.boton {
		background: var(--logo-amarillo);
		border-color: var(--logo-amarillo);
		color: var(--color-oscuro);
	}
	.boton:hover {
		background: #fff;
		border-color: #fff;
		color: var(--color-oscuro);
	}
	.destacado :focus-visible {
		outline-color: var(--logo-amarillo);
	}
	@media (max-width: 48rem) {
		.contenido {
			grid-template-columns: 1fr;
		}
		.afiche {
			width: min(16rem, 70%);
		}
	}
</style>
