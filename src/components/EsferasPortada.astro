---
// Las tres esferas del logo (rojo, amarillo y verde), grandes y en cascada, para la presentación de la portada en
// pantallas medianas y celulares (en las grandes, a la derecha del título va el álbum de fotos). Decorativas:
// aparecen una tras otra y flotan despacio; con "reducir movimiento" quedan quietas.
---

<div class="esferas-portada" aria-hidden="true">
	<svg viewBox="0 0 300 330" focusable="false">
		<defs>
			<radialGradient id="esfera-roja" cx="38%" cy="32%" r="72%">
				<stop offset="0" stop-color="#ff9a8f" />
				<stop offset="0.45" stop-color="#e3151b" />
				<stop offset="1" stop-color="#7d0a0e" />
			</radialGradient>
			<radialGradient id="esfera-amarilla" cx="38%" cy="32%" r="72%">
				<stop offset="0" stop-color="#ffeaa0" />
				<stop offset="0.45" stop-color="#f2b416" />
				<stop offset="1" stop-color="#9a6400" />
			</radialGradient>
			<radialGradient id="esfera-verde" cx="38%" cy="32%" r="72%">
				<stop offset="0" stop-color="#8ee0a8" />
				<stop offset="0.45" stop-color="#0c9439" />
				<stop offset="1" stop-color="#034a18" />
			</radialGradient>
			<radialGradient id="esfera-brillo" cx="50%" cy="50%" r="50%">
				<stop offset="0" stop-color="#fff" stop-opacity="0.85" />
				<stop offset="1" stop-color="#fff" stop-opacity="0" />
			</radialGradient>
		</defs>
		<g class="esfera esfera-roja">
			<circle cx="118" cy="98" r="80" fill="url(#esfera-roja)" />
			<ellipse cx="88" cy="62" rx="30" ry="20" fill="url(#esfera-brillo)" transform="rotate(-30 88 62)" />
		</g>
		<g class="esfera esfera-amarilla">
			<circle cx="222" cy="186" r="62" fill="url(#esfera-amarilla)" />
			<ellipse cx="199" cy="158" rx="23" ry="15" fill="url(#esfera-brillo)" transform="rotate(-30 199 158)" />
		</g>
		<g class="esfera esfera-verde">
			<circle cx="112" cy="262" r="54" fill="url(#esfera-verde)" />
			<ellipse cx="92" cy="238" rx="20" ry="13" fill="url(#esfera-brillo)" transform="rotate(-30 92 238)" />
		</g>
	</svg>
</div>

<style>
	.esferas-portada {
		display: none;
		position: relative;
		z-index: 1;
		pointer-events: none;
	}
	svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}
	.esfera {
		filter: drop-shadow(0 18px 22px rgb(0 0 0 / 0.35));
		transform-box: fill-box;
		transform-origin: center;
	}

	@media (prefers-reduced-motion: no-preference) {
		.esfera {
			animation:
				asomar 0.9s cubic-bezier(0.2, 0.8, 0.2, 1.2) both,
				flotar 6s 1s ease-in-out infinite;
		}
		.esfera-amarilla {
			animation-delay: 0.15s, 1.4s;
			animation-duration: 0.9s, 7.5s;
		}
		.esfera-verde {
			animation-delay: 0.3s, 1.8s;
			animation-duration: 0.9s, 9s;
		}
	}
	@keyframes asomar {
		from {
			opacity: 0;
			transform: translateY(40px) scale(0.5);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@keyframes flotar {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-12px);
		}
	}
</style>
