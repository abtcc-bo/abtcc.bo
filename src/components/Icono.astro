---
// Icono de línea decorativo (los trazos están en src/datos/iconos.ts). Toma el color del texto que lo rodea.
// Con `circulo` va dentro de un círculo verde suave.
import { ICONOS, type NombreIcono } from '../datos/iconos';

interface Props {
	nombre: NombreIcono;
	circulo?: boolean;
	class?: string;
}

const { nombre, circulo = false, class: clase } = Astro.props;
---

<span class:list={['icono', { circulo }, clase]} aria-hidden="true">
	<svg viewBox="0 0 24 24" focusable="false">
		<path d={ICONOS[nombre]} />
	</svg>
</span>

<style>
	.icono {
		display: inline-grid;
		place-items: center;
		flex-shrink: 0;
		width: 1.5rem;
		height: 1.5rem;
		color: var(--color-acento);
	}
	svg {
		width: 100%;
		height: 100%;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.circulo {
		width: 3rem;
		height: 3rem;
		padding: 0.75rem;
		border-radius: 50%;
		background: var(--color-acento-suave);
		transition:
			background-color 0.3s,
			color 0.3s;
	}
</style>
