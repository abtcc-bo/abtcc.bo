---
// Biblioteca del área de socios, como una biblioteca de verdad (diseño aprobado por Leo el 25/11/2026):
//  - Inicio: buscador con sugerencias, "Sigue donde lo dejaste", cinta de libros que se desliza ("Lo nuevo" o,
//    si no hay novedades, "Para descubrir") y los estantes dibujados con lomos.
//  - Estante: sus temas como estantes. Tema: los materiales en repisas, separados por tipo, con portadas
//    generadas (o en lista), y carpetas y tipo como filtros. Ficha (?libro=id): tapa en 3D, datos, Leer y Descargar.
//  - Buscar: resultados de toda la biblioteca, en lista, agrupados por estante y tema.
// La lista se arma en el navegador desde /api/socios/catalogo/ (el Worker gratis tiene poco tiempo de CPU);
// la dirección guarda dónde está el socio (?estante=…&tema=…&libro=…), así funcionan "atrás" y los enlaces.
// Un administrador ve además "Borrar". Las descargas pasan por /api/socios/descargar/<id>/, que revisa la sesión.
// Piezas compartidas en ./portada.ts; estilos en src/styles/biblioteca.css (y los propios, abajo).
import Mensaje from './Mensaje.astro';
import type { EstadoAreaSocios } from '../../lib/area-socios';
import type { Socio } from '../../lib/socios';
import { ESTANTES } from '../../datos/estantes';
import { ORGANIZACION } from '../../datos/organizacion';
import { rutaSocios, t } from '../../i18n';
import '../../styles/biblioteca.css';

interface Props {
	estado: EstadoAreaSocios;
	socio: Socio;
}

const { estado, socio } = Astro.props;
const { idioma } = estado;
const textos = t(idioma).socios;
const b = textos.biblioteca;
const avisosError = ['topeDescargas', 'noEncontrado'];
---

<div class="biblioteca">
	{estado.aviso && avisosError.includes(estado.aviso) && <Mensaje tipo="error">{textos.avisos[estado.aviso]}</Mensaje>}
	{estado.aviso === 'materialBorrado' && <Mensaje tipo="exito">{textos.avisos.materialBorrado}</Mensaje>}

	{
		socio.estado !== 'activo' ? (
			<Mensaje tipo="error">
				{b.inactivo} {ORGANIZACION.correo && <a href={`mailto:${ORGANIZACION.correo}`}>{ORGANIZACION.correo}</a>}
			</Mensaje>
		) : (
			<div
				data-biblioteca
				data-idioma={idioma}
				data-admin={socio.es_admin ? 'si' : undefined}
				data-ruta={rutaSocios('biblioteca', idioma)}
				data-textos={JSON.stringify(b)}
				data-estantes={JSON.stringify(ESTANTES)}
			>
				<div class="sala">
					<p class="bajada">{b.texto}</p>
					<div class="buscador">
						<label for="biblioteca-buscar" class="visualmente-oculto">{b.buscar}</label>
						<svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
						<input id="biblioteca-buscar" type="search" autocomplete="off" placeholder={b.buscar} data-buscar />
					</div>
					<div class="sugerencias" data-sugerencias hidden></div>
				</div>
				<nav class="migas-biblioteca" aria-label={b.titulo} data-migas></nav>
				<p class="estado-lista" aria-live="polite" data-resultados>{b.cargando}</p>
				<div data-vista></div>
				<noscript>
					<p>{b.sinJs}</p>
				</noscript>
				<p class="uso-personal">{b.usoPersonal}</p>
			</div>
		)
	}

	<p class="volver-panel">
		<a href={rutaSocios('inicio', idioma)}>← {textos.cuenta.volver}</a>
	</p>
</div>

<script>
	import { anotarReciente, barajar, el, icono, leerRecientes, lomos, partes, pintar, portada, COLOR_RESPALDO } from './portada';
	import type { Estante, Material } from './portada';

	type Estado = { estante: string; tema: string; carpeta: string; tipo: string; libro: string };
	type Textos = Record<string, string> & { tipos?: Record<string, string> };

	const caja = document.querySelector<HTMLElement>('[data-biblioteca]');
	if (caja) iniciar(caja);

	/** Orden de los grupos por tipo dentro de un tema. */
	const ORDEN_TIPOS = ['Libro', 'Manual o guía', 'Artículo o capítulo', 'Artículo', 'Capítulo', 'Instrumento de evaluación'];
	const CLAVE_VISTA = 'abtcc-biblioteca-vista';

	async function iniciar(caja: HTMLElement) {
		const textos = JSON.parse(caja.dataset.textos ?? '{}') as Textos;
		const estantes = JSON.parse(caja.dataset.estantes ?? '[]') as Estante[];
		const idioma = caja.dataset.idioma ?? 'es';
		const esAdmin = caja.dataset.admin === 'si';
		const ruta = caja.dataset.ruta ?? '';
		const buscar = caja.querySelector<HTMLInputElement>('[data-buscar]')!;
		const sugerencias = caja.querySelector<HTMLElement>('[data-sugerencias]')!;
		const migas = caja.querySelector<HTMLElement>('[data-migas]')!;
		const estadoLista = caja.querySelector<HTMLElement>('[data-resultados]')!;
		const vista = caja.querySelector<HTMLElement>('[data-vista]')!;
		const tx = (clave: string, n?: number) => String(textos[clave] ?? '').replace('{n}', n === undefined ? '' : n.toLocaleString(idioma));
		const cuantos = (n: number) => tx(n === 1 ? 'resultado' : 'resultados', n);
		const plural = (tipo: string) => textos.tipos?.[tipo] ?? tipo;

		let materiales: Material[];
		try {
			const respuesta = await fetch('/api/socios/catalogo/', { headers: { Accept: 'application/json' } });
			if (!respuesta.ok) throw new Error(String(respuesta.status));
			materiales = (await respuesta.json()) as Material[];
		} catch {
			estadoLista.textContent = tx('error');
			return;
		}

		const orden = new Intl.Collator(idioma, { sensitivity: 'base', numeric: true });
		const sinTildes = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
		const slug = (s: string) => sinTildes(s).replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
		for (const m of materiales) {
			m.seccion ??= 'Más temas';
			m.subtema ??= m.tema;
		}
		materiales.sort((a, b) => orden.compare(a.titulo, b.titulo));
		const porId = new Map(materiales.map((m) => [m.id, m]));
		const textoBusqueda = new Map(materiales.map((m) => [m, sinTildes(`${m.titulo} ${m.subtema} ${m.carpeta ?? ''} ${m.tipo} ${m.seccion}`)]));
		const estanteDe = (m: Material) => estantes.find((e) => e.nombre === m.seccion);
		const colorDe = (m: Material) => estanteDe(m)?.color ?? COLOR_RESPALDO;
		// El primer lote (25/11/2026) no lleva el sello "Nuevo"; lo agregado después, durante 30 días.
		const hace30Dias = new Date(Date.now() - 30 * 864e5).toISOString().slice(0, 10);
		const esNuevo = (m: Material) => Boolean(m.agregado && m.agregado > '2026-11-25' && m.agregado >= hace30Dias);
		function contar(lista: Material[], clave: (m: Material) => string | undefined) {
			const mapa = new Map<string, number>();
			for (const m of lista) {
				const k = clave(m);
				if (k) mapa.set(k, (mapa.get(k) ?? 0) + 1);
			}
			return mapa;
		}
		const leerVista = () => {
			try {
				return localStorage.getItem(CLAVE_VISTA) === 'lista' ? 'lista' : 'estante';
			} catch {
				return 'estante';
			}
		};

		// ---------- Dónde está el socio (en la dirección) ----------
		const leer = (): Estado => {
			const p = new URLSearchParams(location.search);
			return { estante: p.get('estante') ?? '', tema: p.get('tema') ?? '', carpeta: p.get('carpeta') ?? '', tipo: p.get('tipo') ?? '', libro: p.get('libro') ?? '' };
		};
		const urlDe = (e: Estado) => {
			const p = new URLSearchParams();
			for (const [k, v] of Object.entries(e)) if (v) p.set(k, v);
			return `${location.pathname}${p.size ? `?${p}` : ''}`;
		};
		function ir(nuevo: Partial<Estado>, reemplazar = false) {
			const url = urlDe({ ...leer(), libro: '', ...nuevo });
			if (reemplazar) history.replaceState(null, '', url);
			else history.pushState(null, '', url);
			dibujar();
			if (!reemplazar) caja.scrollIntoView({ block: 'start' });
		}
		window.addEventListener('popstate', () => dibujar());

		/** Dónde vive un material: su estante y su tema, para que la ficha tenga migas. */
		const lugarDe = (m: Material): Estado => ({ estante: slug(m.seccion ?? ''), tema: slug(m.subtema ?? ''), carpeta: '', tipo: '', libro: m.id });

		/** Enlace a la ficha de un material (funciona también con clic central o "abrir en otra pestaña"). */
		function enlaceFicha(m: Material, clase: string) {
			const a = el('a', clase);
			a.href = urlDe(lugarDe(m));
			a.addEventListener('click', (evento) => {
				if (evento.metaKey || evento.ctrlKey || evento.shiftKey || evento.button !== 0) return;
				evento.preventDefault();
				buscar.value = '';
				ir(lugarDe(m));
			});
			return a;
		}

		function enlaceArchivo(m: Material, texto: string, ver: boolean, clase: string, titulo: string) {
			const a = el('a', clase, texto);
			a.href = `/api/socios/descargar/${m.id}/?idioma=${idioma}${ver ? '&ver=1' : ''}`;
			a.setAttribute('aria-label', `${texto}: ${titulo}`);
			if (ver) {
				a.target = '_blank';
				a.rel = 'noopener';
			}
			a.addEventListener('click', () => anotarReciente(m.id));
			return a;
		}

		function formBorrar(m: Material, titulo: string) {
			const form = el('form', 'form-borrar');
			form.method = 'post';
			form.action = ruta;
			form.dataset.titulo = titulo;
			for (const [nombre, valor] of [
				['accion', 'borrar-material'],
				['id', m.id],
			]) {
				const campo = el('input');
				campo.type = 'hidden';
				campo.name = nombre;
				campo.value = valor;
				form.append(campo);
			}
			const borrar = el('button', 'borrar', tx('borrar'));
			borrar.type = 'submit';
			borrar.setAttribute('aria-label', `${tx('borrar')}: ${titulo}`);
			form.append(borrar);
			return form;
		}

		function acciones(m: Material, titulo: string, chico = true) {
			const fila = el('div', 'acciones-material');
			const tam = chico ? ' boton-chico' : '';
			fila.append(enlaceArchivo(m, tx(chico ? 'ver' : 'leer'), true, `boton${tam}${chico ? ' boton-contorno' : ''}`, titulo));
			fila.append(enlaceArchivo(m, tx('descargar'), false, `boton${tam}${chico ? '' : ' boton-contorno'}`, titulo));
			if (esAdmin) fila.append(formBorrar(m, titulo));
			return fila;
		}

		// ---------- Piezas ----------

		/** Un libro de pie en la repisa: tapa, tramo de tabla, título y autor. */
		function libroEnRepisa(m: Material, i: number) {
			const { titulo, autor, anio } = partes(m);
			const li = el('li');
			li.style.setProperty('--i', String(i));
			const a = enlaceFicha(m, 'libro-repisa');
			const tapa = el('span', 'tapa');
			tapa.append(portada(m, colorDe(m)));
			if (esNuevo(m)) tapa.append(el('span', 'sello-nuevo', tx('nuevo')));
			a.append(tapa, el('span', 'tabla'), el('span', 'nombre-libro', titulo));
			const pie = [autor, anio && !autor.includes(anio) ? anio : ''].filter(Boolean).join(' · ');
			if (pie) a.append(el('span', 'autor-libro', pie));
			li.append(a);
			return li;
		}

		function repisa(items: Material[]) {
			const ul = el('ul', 'repisa');
			items.forEach((m, i) => ul.append(libroEnRepisa(m, i)));
			return ul;
		}

		/** Fila de lista: miniatura, título (a la ficha), detalle y botones. */
		function filaLista(m: Material) {
			const { titulo, autor, anio } = partes(m);
			const li = el('li', 'material');
			const mini = el('span', 'mini');
			mini.append(portada(m, colorDe(m), { mini: true }));
			const datos = el('div', 'datos');
			const enlace = enlaceFicha(m, 'titulo');
			enlace.textContent = titulo;
			const t = el('p', 'titulo-fila');
			t.append(enlace);
			if (esNuevo(m)) t.append(' ', el('span', 'nuevo', tx('nuevo')));
			const detalle = [autor, anio && !autor.includes(anio) ? anio : '', m.tipo, tx('mb', m.mb)].filter(Boolean).join(' · ');
			datos.append(t, el('p', 'detalle', detalle));
			li.append(mini, datos, acciones(m, titulo));
			return li;
		}

		function lista(items: Material[]) {
			const ul = el('ul', 'materiales');
			for (const m of items) ul.append(filaLista(m));
			return ul;
		}

		function chips(valores: Map<string, number>, activo: string, alElegir: (v: string) => void, todos: string, nombre = (v: string) => v) {
			const fila = el('div', 'chips');
			const total = [...valores.values()].reduce((a, n) => a + n, 0);
			const opciones: [string, number][] = [['', total], ...[...valores].sort((a, b) => orden.compare(a[0], b[0]))];
			for (const [valor, n] of opciones) {
				const boton = el('button', 'chip', `${valor ? nombre(valor) : todos} · ${n.toLocaleString(idioma)}`);
				boton.type = 'button';
				boton.setAttribute('aria-pressed', String(valor === activo));
				boton.addEventListener('click', () => alElegir(valor));
				fila.append(boton);
			}
			return fila;
		}

		/** Tarjeta de un estante (o de un tema): lomos que se levantan, ícono, nombre y etiquetas. */
		function mueble(nombre: string, trazo: string, color: string, etiquetas: string[], cantidad: string, i: number, alTocar: () => void) {
			const boton = el('button', 'mueble mueble-entra');
			boton.type = 'button';
			pintar(boton, color);
			boton.style.setProperty('--i', String(i));
			const cabeza = el('span', 'cabeza');
			const circulo = el('span', 'circulo');
			circulo.append(icono(trazo));
			const flecha = el('span', 'flecha', '→');
			flecha.setAttribute('aria-hidden', 'true');
			cabeza.append(circulo, el('span', 'nombre', nombre), flecha);
			const pie = el('span', 'pie');
			for (const e of etiquetas) pie.append(el('span', 'etiqueta-tema', e));
			if (cantidad) pie.append(el('span', 'cantidad', cantidad));
			boton.append(lomos(nombre, color), cabeza, pie);
			boton.addEventListener('click', alTocar);
			return boton;
		}

		/** Cinta de libros que se desliza sola (se detiene con el mouse o el teclado). */
		function cinta(items: Material[]) {
			const marco = el('div', 'cinta-libros');
			const fila = el('div', 'cinta');
			fila.style.setProperty('--duracion', `${Math.max(40, items.length * 6)}s`);
			for (const copia of [0, 1]) {
				for (const m of items) {
					const a = enlaceFicha(m, 'libro-cinta');
					a.append(portada(m, colorDe(m)));
					if (copia) {
						a.setAttribute('aria-hidden', 'true');
						a.tabIndex = -1;
					} else a.setAttribute('aria-label', partes(m).titulo);
					fila.append(a);
				}
			}
			marco.append(fila);
			const bloque = el('div', 'cinta-bloque');
			bloque.append(marco, el('div', 'cinta-tabla'));
			return bloque;
		}

		function encabezado(titulo: string, texto?: string, rotulo?: string) {
			const cab = el('div', 'encabezado-seccion');
			if (rotulo) cab.append(el('p', 'rotulo-seccion', rotulo));
			cab.append(el('h2', '', titulo));
			if (texto) cab.append(el('p', 'texto-seccion', texto));
			return cab;
		}

		function miga(texto: string, alTocar?: () => void) {
			if (!alTocar) return el('span', 'miga-actual', texto);
			const boton = el('button', 'miga', texto);
			boton.type = 'button';
			boton.addEventListener('click', alTocar);
			return boton;
		}

		// Sugerencias del buscador: los temas con más materiales.
		const temasFrecuentes = [...contar(materiales, (m) => m.subtema)].sort((a, b) => b[1] - a[1]).slice(0, 4);
		if (temasFrecuentes.length) {
			sugerencias.append(el('span', 'prueba', tx('pruebaCon')));
			for (const [tema] of temasFrecuentes) {
				const boton = el('button', 'sugerencia-tema', tema);
				boton.type = 'button';
				boton.addEventListener('click', () => {
					buscar.value = tema;
					dibujar();
					buscar.focus();
				});
				sugerencias.append(boton);
			}
		}
		// "Para descubrir": una selección distinta en cada visita (primero libros y manuales, que lucen más).
		const paraDescubrir = barajar(materiales.filter((m) => /^(libro|manual)/i.test(m.tipo))).slice(0, 14);

		// ---------- Dibujo de cada vista ----------
		function dibujar(): void {
			const e = leer();
			const consulta = sinTildes(buscar.value.trim());
			vista.replaceChildren();
			migas.replaceChildren();
			sugerencias.hidden = true;

			// Buscar: toda la biblioteca, en lista, agrupada por estante y tema.
			if (consulta) {
				const palabras = consulta.split(/\s+/);
				const hallados = materiales.filter((m) => palabras.every((p) => textoBusqueda.get(m)!.includes(p)));
				estadoLista.textContent = hallados.length ? cuantos(hallados.length) : tx('sinResultados');
				const grupos = new Map<string, Material[]>();
				for (const m of hallados) {
					const clave = `${m.seccion} › ${m.subtema}`;
					grupos.set(clave, [...(grupos.get(clave) ?? []), m]);
				}
				for (const [grupo, items] of [...grupos].sort((a, b) => orden.compare(a[0], b[0]))) {
					const seccion = el('section', 'grupo');
					seccion.append(el('h2', 'titulo-grupo', `${grupo} (${items.length})`), lista(items));
					vista.append(seccion);
				}
				return;
			}

			const libro = e.libro ? porId.get(e.libro) : undefined;
			const estante = libro ? estanteDe(libro) : estantes.find((x) => slug(x.nombre) === e.estante);
			const enEstante = estante ? materiales.filter((m) => m.seccion === estante.nombre) : [];
			const temas = contar(enEstante, (m) => m.subtema);
			const tema = libro ? libro.subtema : [...temas.keys()].find((t) => slug(t) === e.tema);

			const alInicio = () => ir({ estante: '', tema: '', carpeta: '', tipo: '' });
			migas.append(miga(tx('titulo'), estante || libro ? alInicio : undefined));
			if (estante) migas.append(miga(estante.nombre, (tema && temas.size > 1) || libro ? () => ir({ estante: slug(estante.nombre), tema: '', carpeta: '', tipo: '' }) : undefined));
			if (tema && temas.size > 1) migas.append(miga(tema, libro ? () => ir({ estante: slug(estante!.nombre), tema: slug(tema), carpeta: '', tipo: '' }) : undefined));
			if (libro) migas.append(miga(partes(libro).titulo));

			if (libro) return dibujarFicha(libro);

			// Inicio: "Sigue donde lo dejaste", la cinta y los estantes.
			if (!estante) {
				estadoLista.textContent = '';
				sugerencias.hidden = false;
				const recientes = leerRecientes()
					.map((id) => porId.get(id))
					.filter((m): m is Material => Boolean(m))
					.slice(0, 3);
				if (recientes.length) {
					const s = el('section', 'seguir');
					s.append(el('h2', '', tx('sigue')));
					const ul = el('ul', 'lista-seguir');
					for (const m of recientes) {
						const li = el('li');
						const a = enlaceFicha(m, 'fila-seguir');
						const mini = el('span', 'mini');
						mini.append(portada(m, colorDe(m), { mini: true }));
						const datos = el('span', 'datos');
						datos.append(el('span', 'titulo-fila', partes(m).titulo), el('span', 'detalle', `${m.seccion} · ${m.subtema}`));
						a.append(mini, datos);
						li.append(a);
						ul.append(li);
					}
					s.append(ul);
					vista.append(s);
				}
				const nuevos = materiales.filter(esNuevo).sort((a, b) => (b.agregado ?? '').localeCompare(a.agregado ?? ''));
				const hayNuevos = nuevos.length >= 4;
				const enCinta = hayNuevos ? nuevos.slice(0, 16) : paraDescubrir;
				if (enCinta.length) {
					const s = el('section', 'seccion-cinta');
					s.append(encabezado(tx(hayNuevos ? 'loNuevoTitulo' : 'paraDescubrir'), tx(hayNuevos ? 'loNuevoTexto' : 'paraDescubrirTexto'), tx(hayNuevos ? 'loNuevo' : 'seleccion')));
					s.append(cinta(enCinta), el('p', 'nota-cinta', tx('notaCinta')));
					vista.append(s);
				}
				const s = el('section', 'seccion-estantes');
				s.append(encabezado(tx('estantes'), tx('estantesTexto'), tx('rotuloEstantes')));
				const grilla = el('div', 'estantes');
				let i = 0;
				for (const x of estantes) {
					const propios = materiales.filter((m) => m.seccion === x.nombre);
					if (!propios.length) continue;
					const temasDe = [...contar(propios, (m) => m.subtema)].sort((a, b) => b[1] - a[1]).map(([t]) => t);
					grilla.append(mueble(x.nombre, x.icono, x.color, temasDe.slice(0, 3), '', i++, () => ir({ estante: slug(x.nombre) })));
				}
				s.append(grilla);
				vista.append(s);
				return;
			}

			// Estante sin tema elegido: sus temas como estantes (con un solo tema, se entra directo).
			if (!tema) {
				if (temas.size === 1) return ir({ tema: slug([...temas.keys()][0]) }, true);
				estadoLista.textContent = cuantos(enEstante.length);
				const grilla = el('div', 'estantes subcarpetas');
				let i = 0;
				for (const [t, n] of [...temas].sort((a, b) => orden.compare(a[0], b[0]))) {
					const tipos = [...contar(enEstante.filter((m) => m.subtema === t), (m) => m.tipo)].sort((a, b) => b[1] - a[1]).map(([x]) => plural(x));
					grilla.append(mueble(t, estante.icono, estante.color, tipos.slice(0, 2), cuantos(n), i++, () => ir({ tema: slug(t) })));
				}
				vista.append(grilla);
				return;
			}

			// Tema: materiales en repisas por tipo (o en lista), con carpetas y tipo como filtros.
			const enTema = enEstante.filter((m) => m.subtema === tema);
			const carpetas = contar(enTema, (m) => m.carpeta);
			const carpeta = [...carpetas.keys()].find((c) => slug(c) === e.carpeta) ?? '';
			const enCarpeta = carpeta ? enTema.filter((m) => m.carpeta === carpeta) : enTema;
			const tipos = contar(enCarpeta, (m) => m.tipo);
			const tipo = [...tipos.keys()].find((t) => slug(t) === e.tipo) ?? '';
			const visibles = tipo ? enCarpeta.filter((m) => m.tipo === tipo) : enCarpeta;
			estadoLista.textContent = cuantos(visibles.length);

			const filtros = el('div', 'filtros');
			const izquierda = el('div', 'filtros-chips');
			if (carpetas.size) izquierda.append(chips(carpetas, carpeta, (v) => ir({ carpeta: slug(v), tipo: '' }, true), tx('todo')));
			if (tipos.size > 1) izquierda.append(chips(tipos, tipo, (v) => ir({ tipo: slug(v) }, true), tx('todosLosTipos'), plural));
			const modo = leerVista();
			const selector = el('div', 'selector-vista');
			selector.setAttribute('role', 'group');
			selector.setAttribute('aria-label', tx('vista'));
			for (const [valor, texto] of [
				['estante', tx('vistaEstante')],
				['lista', tx('vistaLista')],
			] as const) {
				const boton = el('button', '', texto);
				boton.type = 'button';
				boton.setAttribute('aria-pressed', String(modo === valor));
				boton.addEventListener('click', () => {
					try {
						localStorage.setItem(CLAVE_VISTA, valor);
					} catch {
						/* sin almacenamiento: vale solo para esta vez */
					}
					dibujar();
				});
				selector.append(boton);
			}
			filtros.append(izquierda, selector);
			vista.append(filtros);

			if (modo === 'lista') {
				vista.append(lista(visibles));
				return;
			}
			const grupos = [...contar(visibles, (m) => m.tipo).keys()].sort((a, b) => {
				const ia = ORDEN_TIPOS.indexOf(a);
				const ib = ORDEN_TIPOS.indexOf(b);
				return (ia < 0 ? 99 : ia) - (ib < 0 ? 99 : ib) || orden.compare(a, b);
			});
			for (const g of grupos) {
				const items = visibles.filter((m) => m.tipo === g);
				const seccion = el('section', 'grupo');
				const cab = el('div', 'cabeza-grupo');
				cab.append(el('h2', 'titulo-grupo', plural(g)), el('span', 'cuenta-grupo', cuantos(items.length)));
				seccion.append(cab, repisa(items));
				vista.append(seccion);
			}
		}

		function dibujarFicha(m: Material) {
			anotarReciente(m.id);
			const { titulo, autor, anio } = partes(m);
			estadoLista.textContent = '';
			const ficha = el('article', 'ficha');

			const escena = el('div', 'ficha-escena');
			escena.setAttribute('aria-hidden', 'true');
			const libro3d = el('div', 'libro3d');
			pintar(libro3d, colorDe(m));
			const frente = el('div', 'frente');
			frente.append(portada(m, colorDe(m)));
			libro3d.append(el('div', 'trasera'), el('div', 'lomo3d'), el('div', 'canto'), frente);
			escena.append(libro3d, el('div', 'sombra-suelo'));

			const datos = el('div', 'ficha-datos');
			const sellos = el('div', 'sellos');
			sellos.append(el('span', 'sello', m.tipo));
			if (esNuevo(m)) sellos.append(el('span', 'sello sello-oro', tx('nuevo')));
			datos.append(sellos, el('h2', 'ficha-titulo', titulo));
			const linea = [autor, anio && !autor.includes(anio) ? anio : ''].filter(Boolean).join(' · ');
			if (linea) datos.append(el('p', 'ficha-autor', linea));
			const dl = el('dl', 'ficha-detalles');
			const dato = (nombre: string, valor?: string) => {
				if (!valor) return;
				const d = el('div');
				d.append(el('dt', '', nombre), el('dd', '', valor));
				dl.append(d);
			};
			dato(tx('estante'), m.seccion);
			dato(tx('tema'), m.subtema);
			dato(tx('carpeta'), m.carpeta);
			dato(tx('archivo'), `${m.ext.toUpperCase()} · ${tx('mb', m.mb)}`);
			datos.append(dl, acciones(m, titulo, false));
			if (m.mb > 10) datos.append(el('p', 'aviso-wifi', tx('wifi')));
			ficha.append(escena, datos);
			vista.append(ficha);

			const vecinos = barajar(materiales.filter((x) => x.subtema === m.subtema && x.seccion === m.seccion && x.id !== m.id)).slice(0, 10);
			if (vecinos.length) {
				const s = el('section', 'grupo vecinos');
				const cab = el('div', 'cabeza-grupo');
				const todo = el('button', 'ver-todo', `${tx('verTodoTema')} →`);
				todo.type = 'button';
				todo.addEventListener('click', () => ir({ estante: slug(m.seccion ?? ''), tema: slug(m.subtema ?? ''), carpeta: '', tipo: '' }));
				cab.append(el('h2', 'titulo-grupo', tx('mismoTema')), todo);
				s.append(cab, repisa(vecinos));
				vista.append(s);
			}
		}

		vista.addEventListener('submit', (evento) => {
			const form = evento.target as HTMLFormElement;
			if (!window.confirm(tx('confirmarBorrar').replace('{titulo}', form.dataset.titulo ?? ''))) evento.preventDefault();
		});
		let espera: ReturnType<typeof setTimeout> | undefined;
		buscar.addEventListener('input', () => {
			clearTimeout(espera);
			espera = setTimeout(dibujar, 200);
		});
		dibujar();
	}
</script>

