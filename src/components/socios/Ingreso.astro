---
// Formulario de ingreso al área de socios: usuario, código o correo + contraseña.
// Se envía a la misma página; lo atiende src/lib/area-socios.ts (límite de intentos, Turnstile y Supabase).
import { TURNSTILE_SITE_KEY } from 'astro:env/client';
import CampoClave from './CampoClave.astro';
import Mensaje from './Mensaje.astro';
import type { EstadoAreaSocios } from '../../lib/area-socios';
import { ORGANIZACION } from '../../datos/organizacion';
import { ruta, rutaSocios, t } from '../../i18n';

interface Props {
	estado: EstadoAreaSocios;
}

const { estado } = Astro.props;
const { idioma } = estado;
const textos = t(idioma).socios;
const error = estado.error?.formulario === 'ingreso' ? estado.error.tipo : undefined;
---

<div class="tarjeta-socios">
	<h2>{textos.ingreso.titulo}</h2>
	<p class="bajada">{textos.ingreso.texto}</p>

	{estado.aviso === 'sesionCerrada' && <Mensaje tipo="exito">{textos.avisos.sesionCerrada}</Mensaje>}
	{error && <Mensaje tipo="error">{textos.errores[error]}</Mensaje>}

	<form method="post" action={rutaSocios('inicio', idioma)}>
		<input type="hidden" name="accion" value="ingresar" />
		<div class="campo">
			<label for="socio-identificador">{textos.ingreso.identificador}</label>
			<input
				id="socio-identificador"
				name="identificador"
				type="text"
				autocomplete="username"
				autocapitalize="none"
				spellcheck="false"
				required
				maxlength="200"
				value={estado.valores.identificador ?? ''}
				aria-invalid={error === 'credenciales' ? 'true' : undefined}
			/>
		</div>
		<CampoClave idioma={idioma} id="socio-clave" nombre="clave" etiqueta={textos.ingreso.clave} autocomplete="current-password" invalido={error === 'credenciales'} />
		<label class="casilla">
			<input type="checkbox" name="recordar" value="si" checked={estado.valores.recordar === 'si'} />
			{textos.ingreso.recordar}
		</label>
		{TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-language={idioma} />}
		<button class="boton" type="submit">
			{textos.ingreso.entrar} <span class="flecha" aria-hidden="true">→</span>
		</button>
	</form>

	<p class="enlaces">
		<a href={rutaSocios('recuperar', idioma)}>{textos.ingreso.olvide}</a>
	</p>

	<p class="pie-tarjeta">
		{
			ORGANIZACION.correo && (
				<>
					{textos.ingreso.problemas} <a href={`mailto:${ORGANIZACION.correo}`}>{ORGANIZACION.correo}</a>.<br />
				</>
			)
		}
		{textos.ingreso.noSocio} <a href={ruta('membresia', idioma)}>{textos.ingreso.serMiembro}</a>.
	</p>
</div>

{TURNSTILE_SITE_KEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
