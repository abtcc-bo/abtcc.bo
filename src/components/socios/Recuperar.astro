---
// "¿Olvidaste tu contraseña?": pide el correo y Supabase envía un enlace para crear una nueva.
// Siempre responde lo mismo, exista o no el correo, para que nadie pueda averiguar quién es socio.
import { TURNSTILE_SITE_KEY } from 'astro:env/client';
import Mensaje from './Mensaje.astro';
import type { EstadoAreaSocios } from '../../lib/area-socios';
import { rutaSocios, t } from '../../i18n';

interface Props {
	estado: EstadoAreaSocios;
}

const { estado } = Astro.props;
const { idioma } = estado;
const textos = t(idioma).socios;
const error = estado.error?.formulario === 'recuperar' ? estado.error.tipo : undefined;
const enviado = estado.aviso === 'correoEnviado';
---

<div class="tarjeta-socios">
	<h2>{textos.titulos.recuperar}</h2>

	{
		enviado ? (
			<Mensaje tipo="exito">{textos.avisos.correoEnviado}</Mensaje>
		) : (
			<>
				<p class="bajada">{textos.recuperar.texto}</p>
				{error && <Mensaje tipo="error">{textos.errores[error]}</Mensaje>}
				<form method="post" action={rutaSocios('recuperar', idioma)}>
					<input type="hidden" name="accion" value="recuperar" />
					<div class="campo">
						<label for="socio-correo">{textos.recuperar.correo}</label>
						<input
							id="socio-correo"
							name="correo"
							type="email"
							autocomplete="email"
							required
							maxlength="200"
							value={estado.valores.correo ?? ''}
							aria-invalid={error === 'correo' ? 'true' : undefined}
						/>
					</div>
					{TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-language={idioma} />}
					<button class="boton" type="submit">
						{textos.recuperar.enviar} <span class="flecha" aria-hidden="true">→</span>
					</button>
				</form>
			</>
		)
	}

	<p class="enlaces">
		<a href={rutaSocios('inicio', idioma)}>← {textos.recuperar.volver}</a>
	</p>
</div>

{TURNSTILE_SITE_KEY && !enviado && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
