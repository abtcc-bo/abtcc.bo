---
// Comisión directiva: personas con `comision: true` en src/content/personas/.
import { Image } from 'astro:assets';
import JsonLd from '../components/JsonLd.astro';
import { obtenerComision, textosDePersona } from '../lib/contenido';
import { t, type Idioma } from '../i18n';

interface Props {
	idioma: Idioma;
}

const { idioma } = Astro.props;
const textos = t(idioma);
const comision = await obtenerComision();

const iniciales = (nombre: string) =>
	nombre
		.split(' ')
		.slice(0, 2)
		.map((parte) => parte[0])
		.join('');
---


<ul class="integrantes">
	{
		comision.map((persona) => {
			const { cargo, bio, formacion, areas, idioma: idiomaTexto } = textosDePersona(persona, idioma);
			const langTexto = idiomaTexto !== idioma ? idiomaTexto : undefined;
			const { nombre, foto, titulo_profesional, enlaces } = persona.data;
			const listaEnlaces = Object.entries(enlaces).filter(([, url]) => url);
			return (
				<li class="integrante" id={persona.id}>
					{foto ? (
						<Image src={foto} alt={nombre} width={240} height={240} class="foto" />
					) : (
						<div class="foto sin-foto" aria-hidden="true">
							{iniciales(nombre)}
						</div>
					)}
					<div>
						<h2>{nombre}</h2>
						{titulo_profesional && <p class="titulo">{titulo_profesional}</p>}
						<p class="cargo" lang={langTexto}>
							{cargo}
						</p>
						<p lang={langTexto}>{bio}</p>
						{formacion.length > 0 && (
							<>
								<h3>{textos.comision.formacion}</h3>
								<ul lang={langTexto}>
									{formacion.map((titulo) => (
										<li>{titulo}</li>
									))}
								</ul>
							</>
						)}
						{areas.length > 0 && (
							<>
								<h3>{textos.comision.areas}</h3>
								<p lang={langTexto}>{areas.join(' · ')}</p>
							</>
						)}
						{listaEnlaces.length > 0 && (
							<ul class="enlaces">
								{listaEnlaces.map(([red, url]) => (
									<li>
										<a href={url} rel="noopener">
											{red}
										</a>
									</li>
								))}
							</ul>
						)}
					</div>
					<JsonLd
						datos={{
							'@type': 'Person',
							name: nombre,
							jobTitle: cargo,
							description: bio,
							...(listaEnlaces.length && { sameAs: listaEnlaces.map(([, url]) => url) }),
							memberOf: { '@id': new URL('/#organizacion', Astro.site).href },
						}}
					/>
				</li>
			);
		})
	}
</ul>

<style>
	.integrantes {
		list-style: none;
		padding: 0;
		margin: 3rem 0 0;
		display: grid;
		gap: 1.5rem;
	}
	.integrante {
		display: grid;
		grid-template-columns: 10rem 1fr;
		gap: 2rem;
		align-items: start;
		padding: 2rem;
		background: var(--color-superficie);
		border: 1px solid var(--color-borde);
		border-radius: var(--radio);
	}
	.foto {
		width: 10rem;
		height: 10rem;
		object-fit: cover;
		border-radius: 50%;
		box-shadow: 0 0 0 4px var(--color-superficie), 0 0 0 5px var(--color-borde);
	}
	.sin-foto {
		display: grid;
		place-items: center;
		background: var(--color-acento-suave);
		font-family: var(--fuente-titulos);
		font-size: 2.5rem;
		color: var(--color-acento);
	}
	h2 {
		margin: 0;
		font-size: 1.875rem;
	}
	.titulo {
		margin: 0.25rem 0 0;
		color: var(--color-texto-suave);
	}
	.cargo {
		margin: 0.5rem 0 1rem;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-acento);
	}
	h3 {
		margin: 1.25rem 0 0.4rem;
		font-family: var(--fuente-texto);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-texto-suave);
	}
	.integrante ul:not(.enlaces) {
		margin: 0;
		padding-left: 1.1rem;
		font-size: 1rem;
	}
	.enlaces {
		display: flex;
		gap: var(--espacio);
		list-style: none;
		padding: 0;
		text-transform: capitalize;
	}
	@media (max-width: 40rem) {
		.integrante {
			grid-template-columns: 1fr;
			gap: 1.25rem;
			padding: 1.5rem;
		}
		.foto {
			width: 8rem;
			height: 8rem;
		}
	}
</style>
