---
// Página de texto (nosotros, legales, etc.) escrita en src/content/paginas/.
import { render, type CollectionEntry } from 'astro:content';
import type { Miga } from '../components/Migas.astro';

interface Props {
	pagina: CollectionEntry<'paginas'>;
	/** Páginas que cuelgan de esta (p. ej. Comisión directiva dentro de Quiénes somos). */
	subsecciones?: Miga[];
}

const { pagina, subsecciones = [] } = Astro.props;
const { Content } = await render(pagina);
---

<article class="pagina">
	<h1>{pagina.data.titulo}</h1>
	{
		subsecciones.length > 0 && (
			<ul class="subsecciones">
				{subsecciones.map((s) => (
					<li>
						<a href={s.href}>{s.nombre}</a>
					</li>
				))}
			</ul>
		)
	}
	<Content />
</article>

<style>
	/* La página de texto va sobre una hoja blanca, separada del fondo. */
	.pagina {
		max-width: calc(var(--ancho-lectura) + 6rem);
		margin-top: var(--espacio);
		padding: clamp(1.5rem, 5vw, 3rem);
		background: var(--color-superficie);
		border: 1px solid var(--color-borde);
		border-radius: var(--radio);
		box-shadow: var(--sombra);
	}
	.pagina > :global(h1) {
		margin-top: 0;
	}
	/* Cada apartado empieza con una línea divisoria. */
	.pagina :global(h2) {
		margin-top: 2.75rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-division);
	}
	.subsecciones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0 0 calc(var(--espacio) * 2);
	}
	.subsecciones a {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding-inline: 1rem;
		border: 1px solid var(--color-borde);
		border-radius: 999px;
		background: var(--color-superficie);
		font-size: 0.9375rem;
		font-weight: 600;
		text-decoration: none;
	}
	.subsecciones a:hover {
		border-color: var(--color-acento);
	}
	/* Los títulos de sección llevan una línea corta con los colores del logo. */
	.pagina :global(h2)::before {
		content: '';
		display: block;
		width: 2.5rem;
		height: 3px;
		margin-bottom: 0.75rem;
		background: var(--franja-tricolor);
	}

	.pagina :global(table) {
		border-collapse: collapse;
		width: 100%;
	}
	.pagina :global(th),
	.pagina :global(td) {
		border: 1px solid var(--color-borde);
		padding: 0.5rem;
		text-align: left;
		vertical-align: top;
	}
</style>
