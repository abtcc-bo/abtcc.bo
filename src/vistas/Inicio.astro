---
import { Image } from 'astro:assets';
import logo from '../assets/logo-completo.webp';
import CarruselEventos from '../components/CarruselEventos.astro';
import EventoDestacado from '../components/EventoDestacado.astro';
import FranjaFotos from '../components/FranjaFotos.astro';
import { ORGANIZACION } from '../datos/organizacion';
import { obtenerEventosPublicos, yaPaso } from '../lib/contenido';
import { ruta, t, type Idioma } from '../i18n';

interface Props {
	idioma: Idioma;
}

const { idioma } = Astro.props;
const textos = t(idioma);
const eventos = await obtenerEventosPublicos(idioma);
const proximos = eventos.filter((e) => !yaPaso(e)).slice(0, 6);
const destacado = proximos.find((e) => e.datos.destacado);
const realizados = eventos.filter((e) => yaPaso(e)).reverse();
---

<section class="portada banda banda-clara" aria-labelledby="titulo-portada">
	<div class="presentacion">
		<p class="antetitulo">{textos.sitio.sigla} · {ORGANIZACION.pais}</p>
		<h1 id="titulo-portada">{textos.sitio.nombre}</h1>
		<p class="bajada">{textos.sitio.descripcion}</p>
		<p class="acciones">
			<a class="boton" href={ruta('eventos', idioma)}>{textos.nav.eventos}</a>
			<a class="boton boton-secundario" href={ruta('membresia', idioma)}>{textos.nav.membresia}</a>
		</p>
	</div>
	<!-- Decorativo: el nombre de la asociación ya está en el título. -->
	<Image src={logo} alt="" widths={[400, 800]} sizes="(max-width: 48rem) 16rem, 24rem" class="logo-portada" loading="eager" />
</section>

{destacado && <EventoDestacado evento={destacado} idioma={idioma} />}

<section class="proximos banda" aria-labelledby="titulo-proximos">
	<div class="cabecera">
		<h2 id="titulo-proximos">{textos.comun.proximosEventos}</h2>
		<a href={ruta('eventos', idioma)}>{textos.comun.verTodos} <span aria-hidden="true">→</span></a>
	</div>
	<CarruselEventos eventos={proximos} idioma={idioma} />
</section>

<FranjaFotos eventos={realizados} idioma={idioma} />

<style>
	.portada {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: 2rem 4rem;
		padding-block: clamp(3.5rem, 9vw, 7rem);
		border-top: 0;
	}
	.logo-portada {
		width: clamp(16rem, 28vw, 24rem);
		height: auto;
	}
	@media (max-width: 56rem) {
		.portada {
			grid-template-columns: 1fr;
		}
		/* En pantallas angostas el logo va arriba del texto. */
		.logo-portada {
			order: -1;
			width: min(15rem, 70%);
		}
	}
	.portada h1 {
		max-width: 18ch;
		margin: 1rem 0 1.25rem;
		font-size: clamp(2.75rem, 1.6rem + 4.2vw, 4.75rem);
		line-height: 1.02;
	}
	.bajada {
		max-width: 40rem;
		margin: 0;
		font-size: 1.25rem;
		color: var(--color-texto-suave);
	}
	.acciones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 2rem 0 0;
	}
	.cabecera {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem var(--espacio);
		margin: 0 0 calc(var(--espacio) * 1.5);
	}
	.cabecera h2 {
		margin: 0;
	}
	.cabecera a {
		font-weight: 600;
		text-decoration: none;
	}
</style>
