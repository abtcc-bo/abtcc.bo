---
// Portada. Textos en src/content/paginas/{idioma}/inicio.md (campo `portada`); sin ese archivo se muestran solo
// el título, la agenda y las fotos. Orden (parecido al de las asociaciones de la red ALAPCCO): presentación, datos,
// evento destacado, quiénes somos, membresía, agenda, "¿por dónde empiezo?", fotos, comisión directiva, cómo se
// organiza la asociación, red de terapeutas y contacto.
import type { CollectionEntry } from 'astro:content';
import AlbumPortada from '../components/AlbumPortada.astro';import BandaEvento from '../components/BandaEvento.astro';
import CarruselEventos from '../components/CarruselEventos.astro';
import CintaConceptos from '../components/CintaConceptos.astro';
import FranjaAliados from '../components/FranjaAliados.astro';
import FranjaFotos from '../components/FranjaFotos.astro';
import Icono from '../components/Icono.astro';
import { Image } from 'astro:assets';
import logoCompleto from '../assets/logo-completo.png';
import logoSimbolo from '../assets/logo-simbolo.png';
import logoAlapcco from '../content/aliados/logos/alapcco.webp';
import RegistroAcumulativo from '../components/RegistroAcumulativo.astro';
import TarjetaDestacada from '../components/TarjetaDestacada.astro';
import { ORGANIZACION } from '../datos/organizacion';
import { obtenerComision, obtenerEventosPublicos, paginaDeSeccion, textosDePersona, yaPaso } from '../lib/contenido';
import { esNavidad } from '../datos/temporada';
import { formato, ruta, t, type Idioma } from '../i18n';

interface Props {
	idioma: Idioma;
	pagina?: CollectionEntry<'paginas'>;
}

const { idioma, pagina } = Astro.props;
const textos = t(idioma);
const v = textos.inicio;
const p = pagina?.data.portada;
const membresia = (await paginaDeSeccion('membresia', idioma))?.data.membresia;
const comision = p?.comision ? await obtenerComision() : [];

const eventos = await obtenerEventosPublicos(idioma);
const proximos = eventos.filter((e) => !yaPaso(e)).slice(0, 6);
const destacado = proximos.find((e) => e.datos.destacado);
const realizados = eventos.filter((e) => yaPaso(e)).reverse();
// Al lado del título va el álbum de fotos de los eventos realizados. Sin fotos, la tarjeta del evento destacado
// (en crema si es navideño, para que resalte la tarjeta vino) o el logo.
const conAlbum = realizados.some((e) => e.datos.galeria.length > 0);
const clara = !conAlbum && destacado?.datos.tema === 'navidad';
// El evento destacado va debajo del título: con programa, el anuncio grande; sin programa, la tarjeta ancha.
const conPrograma = destacado && destacado.texto.data.programa.length > 0;
---

<section class:list={['portada banda', clara ? 'portada-clara' : 'banda-azul', { nieve: esNavidad() && !clara }]} aria-labelledby="titulo-portada">
	<RegistroAcumulativo />
	<div class="presentacion">
		{p && <p class="antetitulo">{p.antetitulo}</p>}
		<h1 id="titulo-portada" class:list={{ 'tres-c': p?.tresC }}>
			{
				p?.tresC ? (
					<>
						<span class="previo">
							{p.tituloPrevio} {p.titulo}
						</span>{' '}
						{p.tresC.map((c, i) => (
							<span class:list={['c', `c-${i + 1}`, { cursiva: i === 2 }]}>
								<span class="esfera" aria-hidden="true" />
								{c}{' '}
							</span>
						))}
					</>
				) : p ? (
					<>
						<span class="previo">{p.tituloPrevio}</span> {p.titulo} {p.tituloCursiva && <span class="cursiva">{p.tituloCursiva}</span>}
					</>
				) : (
					textos.sitio.nombre
				)
			}
		</h1>
		<p class="bajada">{p?.bajada ?? textos.sitio.descripcion}</p>
		<p class="acciones">
			<a class="boton boton-realce" href={ruta('eventos', idioma)}>
				{v.verEventos} <span class="flecha" aria-hidden="true">→</span>
			</a>
			<a class="boton boton-contorno" href={ruta('membresia', idioma)}>{v.hazteMiembro}</a>
		</p>
		{
			p && p.datos.length > 0 && (
				<ul class="datos">
					{p.datos.map((dato) => (
						<li>{dato}</li>
					))}
				</ul>
			)
		}
	</div>
	<div class="lateral">
		{
			conAlbum ? (
				<AlbumPortada eventos={realizados} idioma={idioma} />
			) : destacado ? (
				<TarjetaDestacada evento={destacado} idioma={idioma} />
			) : (
				<div class="logo-portada">
					<Image src={logoCompleto} alt={textos.sitio.nombre} widths={[400, 800]} sizes="24rem" />
				</div>
			)
		}
	</div>
</section>

{p && <CintaConceptos conceptos={p.conceptos} etiqueta={v.conceptos} oscura={clara} />}

{
	p && p.hechos.length > 0 && (
		<section class="banda banda-clara hechos" aria-label={textos.sitio.sigla}>
			<ul>
				{p.hechos.map((hecho) => (
					<li>
						<strong>{hecho.titulo}</strong>
						<span>{hecho.texto}</span>
					</li>
				))}
			</ul>
		</section>
	)
}

{destacado && conPrograma && <BandaEvento evento={destacado} idioma={idioma} />}
{
	destacado && !conPrograma && conAlbum && (
		<section class="banda destacado-ancho">
			<TarjetaDestacada evento={destacado} idioma={idioma} forma="horizontal" />
		</section>
	)
}

{
	p && (
		<section class="banda quienes" aria-labelledby="titulo-quienes">
			<div>
				<p class="antetitulo">{p.quienes.antetitulo}</p>
				<h2 id="titulo-quienes">{p.quienes.titulo}</h2>
				<p class="texto">{p.quienes.texto}</p>
				<p class="enlaces">
					<a class="enlace-accion" href={ruta('comision', idioma)}>
						{v.verComision} <span class="flecha" aria-hidden="true">→</span>
					</a>
					<a class="enlace-accion" href={ruta('transparencia', idioma)}>
						{v.estatuto}
					</a>
				</p>
			</div>
			<ol class="puntos">
				{p.quienes.puntos.map((punto, i) => (
					<li>
						<p class="marca">
							{punto.icono && <Icono nombre={punto.icono} circulo />}
							<span class="numeral">{String(i + 1).padStart(2, '0')}</span>
						</p>
						<h3>{punto.titulo}</h3>
						<p>{punto.texto}</p>
					</li>
				))}
			</ol>
		</section>
	)
}

{
	p && (
		<section class="banda banda-color banda-hoja membresia" aria-labelledby="titulo-membresia">
			<div>
				<p class="antetitulo">{p.membresia.antetitulo}</p>
				<h2 id="titulo-membresia">{p.membresia.titulo}</h2>
				<p class="texto-claro">{p.membresia.texto}</p>
				<ul class="beneficios">
					{p.membresia.beneficios.map((b) => (
						<li>{b}</li>
					))}
				</ul>
				<p class="acciones">
					<a class="boton boton-realce" href={`${ruta('membresia', idioma)}#solicitar`}>
						{textos.membresia.solicitar} <span class="flecha" aria-hidden="true">→</span>
					</a>
					<a class="enlace-accion" href={`${ruta('membresia', idioma)}#requisitos`}>
						{v.verRequisitos}
					</a>
				</p>
			</div>
			{membresia && (
				<div>
					<ul class="categorias">
						{membresia.categorias.map((c) => (
							<li>
								<p class="categoria">
									<span class="nombre">{c.nombre}</span>
									<span class="participacion">{c.participacion}</span>
								</p>
								<p>{c.texto}</p>
							</li>
						))}
					</ul>
					<p class="cuota">
						<span>{formato(v.cuota, { monto: membresia.cuota.monto, unidad: membresia.cuota.unidad })}</span>
						<span>{v.exentos}</span>
					</p>
				</div>
			)}
			{membresia && membresia.pasos.length > 0 && (
				<div class="afiliarse">
					<h3>{v.comoAfiliarse}</h3>
					<ol>
						{membresia.pasos.map((paso) => (
							<li>
								<strong>{paso.titulo}</strong>
								<span>{paso.texto}</span>
							</li>
						))}
					</ol>
				</div>
			)}
		</section>
	)
}

<section class="proximos banda banda-clara" aria-labelledby="titulo-proximos">
	<div class="cabecera-seccion">
		<div>
			<p class="antetitulo">{v.agenda}</p>
			<h2 id="titulo-proximos">{textos.comun.proximosEventos}</h2>
		</div>
		<p class="enlaces">
			<a class="enlace-accion" href={ruta('eventos', idioma)}>
				{v.verTodosEventos} <span class="flecha" aria-hidden="true">→</span>
			</a>
		</p>
	</div>
	<CarruselEventos eventos={proximos} idioma={idioma} />
</section>

{
	p?.caminos && (
		<section class="banda caminos" aria-labelledby="titulo-caminos">
			<p class="antetitulo">{p.caminos.antetitulo}</p>
			<h2 id="titulo-caminos">{p.caminos.titulo}</h2>
			<ul class="opciones">
				{p.caminos.opciones.map((c) => (
					<li class="tarjeta">
						<Icono nombre={c.icono} circulo />
						<h3>{c.titulo}</h3>
						<p>{c.texto}</p>
						<ul class="enlaces-camino">
							{c.enlaces.map((e) => (
								<li>
									<a class="enlace-accion" href={`${ruta(e.seccion, idioma)}${e.ancla ? `#${e.ancla}` : ''}`}>
										{e.texto} <span class="flecha" aria-hidden="true">→</span>
									</a>
								</li>
							))}
						</ul>
					</li>
				))}
			</ul>
			{p.caminos.aviso && <p class="aviso">{p.caminos.aviso}</p>}
		</section>
	)
}

<FranjaFotos eventos={realizados} idioma={idioma} />

{
	p && (
		<section class="banda cita" aria-label={p.cita.fuente}>
			<span class="puntos-logo" aria-hidden="true" />
			<blockquote>
				<p>{p.cita.texto}</p>
			</blockquote>
			<p class="fuente">{p.cita.fuente}</p>
		</section>
	)
}

{
	p?.comision && comision.length > 0 && (
		<section class="banda banda-clara directiva" aria-labelledby="titulo-directiva">
			<div class="cabecera-seccion">
				<div>
					<p class="antetitulo">{p.comision.antetitulo}</p>
					<h2 id="titulo-directiva">{p.comision.titulo}</h2>
				</div>
				<p class="enlaces">
					<a class="enlace-accion" href={ruta('comision', idioma)}>
						{v.verComision} <span class="flecha" aria-hidden="true">→</span>
					</a>
				</p>
			</div>
			<ul class="integrantes">
				{comision.map((persona) => {
					const propios = textosDePersona(persona, idioma);
					return (
						<li>
							{persona.data.foto ? (
								<Image class="retrato" src={persona.data.foto} alt="" widths={[240, 480]} sizes="(min-width: 56rem) 13rem, 45vw" />
							) : (
								<span class="retrato" aria-hidden="true" />
							)}
							<p class="persona">{persona.data.nombre}</p>
							<p class="cargo" lang={propios.idioma === idioma ? undefined : propios.idioma}>
								{propios.cargo}
							</p>
							{persona.data.titulo_profesional && <p class="profesion">{persona.data.titulo_profesional}</p>}
						</li>
					);
				})}
			</ul>
		</section>
	)
}

{
	p?.organizacion && (
		<section class="banda organizacion" aria-labelledby="titulo-organizacion">
			<div>
				<p class="antetitulo">{p.organizacion.antetitulo}</p>
				<h2 id="titulo-organizacion">{p.organizacion.titulo}</h2>
				{p.organizacion.texto && <p class="texto">{p.organizacion.texto}</p>}
				<p class="enlaces">
					<a class="enlace-accion" href={ruta('transparencia', idioma)}>
						{v.estatuto} <span class="flecha" aria-hidden="true">→</span>
					</a>
				</p>
			</div>
			<dl class="organos">
				{p.organizacion.organos.map((organo) => (
					<div>
						<dt>{organo.nombre}</dt>
						<dd>{organo.texto}</dd>
					</div>
				))}
			</dl>
		</section>
	)
}

{
	p && (
		<section class="banda red" aria-labelledby="titulo-red">
			<div>
				<p class="antetitulo">{p.red.antetitulo}</p>
				<h2 id="titulo-red">{p.red.titulo}</h2>
				<p class="texto">{p.red.texto}</p>
			</div>
			<div class="logos">
				<div class="logo-caja tarjeta">
					<Image src={logoSimbolo} alt={textos.sitio.sigla} widths={[200, 400]} sizes="10rem" />
				</div>
				<a class="logo-caja tarjeta" href="https://alapcco.com/" rel="noopener">
					<Image src={logoAlapcco} alt="ALAPCCO" widths={[200, 400]} sizes="10rem" />
				</a>
			</div>
		</section>
	)
}

<FranjaAliados idioma={idioma} />

{
	p?.contacto && (
		<section class="banda cierre-contacto" aria-labelledby="titulo-contacto">
			<div class="banda-azul banda-hoja caja-contacto">
				<div>
					<h2 id="titulo-contacto">{p.contacto.titulo}</h2>
					<p>{p.contacto.texto}</p>
				</div>
				<p class="acciones">
					<a class="boton boton-realce" href={ruta('contacto', idioma)}>
						{v.escribenos} <span class="flecha" aria-hidden="true">→</span>
					</a>
					{ORGANIZACION.correo && (
						<a class="boton boton-contorno" href={`mailto:${ORGANIZACION.correo}`}>
							{ORGANIZACION.correo}
						</a>
					)}
				</p>
			</div>
		</section>
	)
}

<style>
	/* ---------- Presentación ---------- */
	.portada {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
		align-items: center;
		gap: 3rem 4rem;
		padding-block: clamp(3.5rem, 8vw, 6rem);
		overflow: hidden;
	}
	.presentacion,
	.lateral {
		position: relative;
		z-index: 1;
	}
	.portada h1 {
		margin: 1.25rem 0 1.5rem;
		font-size: clamp(2.8rem, 1.6rem + 4.4vw, 4.6rem);
		line-height: 1.04;
	}
	/* Presentación clara (Navidad): textos oscuros, "Contextuales" en verde y puntos de colores. */
	.portada-clara {
		position: relative;
	}
	.portada-clara .previo {
		font-style: normal;
		color: var(--color-texto-suave);
	}
	.portada-clara .cursiva {
		color: var(--color-acento);
	}
	.portada-clara .bajada {
		color: var(--color-texto-suave);
	}
	.portada-clara .datos {
		border-top-color: var(--color-division);
		color: var(--color-texto-suave);
	}
	.portada-clara .datos li:nth-child(odd)::before {
		background: var(--logo-rojo);
	}
	.portada-clara .datos li:nth-child(even)::before {
		background: var(--logo-verde);
	}
	.portada-clara::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background-image:
			radial-gradient(circle at 20% 30%, rgb(214 168 60 / 0.6) 0 1.6px, transparent 2.2px),
			radial-gradient(circle at 75% 65%, rgb(200 32 42 / 0.45) 0 1.4px, transparent 2px);
		background-size:
			260px 260px,
			340px 340px;
	}
	.previo {
		display: block;
		margin-bottom: 0.35rem;
		font-size: 0.5em;
		font-style: italic;
		color: var(--color-realce);
	}
	/* Las tres C: cada palabra con su esfera del logo (con brillo, como en el logo). La letra se achica más en
	   celulares para que "Conductuales" quepa entera aun en pantallas de 320 px. */
	.portada h1.tres-c {
		font-size: clamp(2.1rem, 0.9rem + 6.6vw, 4.6rem);
	}
	.c {
		display: flex;
		align-items: center;
		gap: 0.32em;
	}
	.c + .c {
		margin-top: 0.04em;
	}
	.esfera {
		flex-shrink: 0;
		width: 0.42em;
		height: 0.42em;
		border-radius: 50%;
		box-shadow: 0 0.06em 0.14em rgb(0 0 0 / 0.35);
	}
	.c-1 .esfera {
		background: radial-gradient(circle at 34% 30%, #ffb3a8 0, #e3151b 42%, #7d0a0e 100%);
	}
	.c-2 .esfera {
		background: radial-gradient(circle at 34% 30%, #fff0b8 0, #f2b416 42%, #9a6400 100%);
	}
	.c-3 .esfera {
		background: radial-gradient(circle at 34% 30%, #a6ecbc 0, #0c9439 42%, #034a18 100%);
	}
	.c.cursiva {
		font-style: italic;
		font-weight: 500;
	}
	/* Al cargar, cada C entra desde la izquierda y su esfera aparece con un pequeño rebote, una tras otra. */
	@media (prefers-reduced-motion: no-preference) {
		.c {
			animation: entrar-c 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
		}
		.esfera {
			animation: rebotar 0.7s cubic-bezier(0.3, 1.6, 0.5, 1) both;
		}
		.c-1,
		.c-1 .esfera {
			animation-delay: 0.15s;
		}
		.c-2,
		.c-2 .esfera {
			animation-delay: 0.35s;
		}
		.c-3,
		.c-3 .esfera {
			animation-delay: 0.55s;
		}
	}
	@keyframes entrar-c {
		from {
			opacity: 0;
			transform: translateX(-0.4em);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@keyframes rebotar {
		from {
			transform: scale(0);
		}
		to {
			transform: scale(1);
		}
	}
	.bajada {
		max-width: 34rem;
		margin: 0;
		font-size: 1.0625rem;
		color: var(--texto-banda);
	}
	.portada .acciones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 2rem 0 0;
	}
	.datos {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.75rem;
		margin: 2rem 0 0;
		padding: 1.25rem 0 0;
		border-top: 1px solid rgb(255 255 255 / 0.15);
		list-style: none;
		font-size: 0.8125rem;
		color: var(--texto-banda-suave);
	}
	.datos li::before {
		content: '';
		display: inline-block;
		width: 6px;
		height: 6px;
		margin-right: 0.5rem;
		border-radius: 50%;
		background: var(--color-realce);
		vertical-align: middle;
	}
	.lateral {
		max-width: 26rem;
		justify-self: end;
		width: 100%;
	}
	.logo-portada {
		padding: 2.5rem;
		border-radius: var(--radio);
		background: var(--color-tarjeta);
	}

	/* ---------- ¿Por dónde empiezo? ---------- */
	.caminos h2 {
		margin-top: 0.75rem;
	}
	.opciones {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
		gap: 1.25rem;
		margin: 2.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	.opciones > li {
		display: flex;
		flex-direction: column;
		padding: 1.75rem;
		border-start-start-radius: 2rem;
		transition:
			transform 0.3s,
			box-shadow 0.3s,
			border-color 0.3s;
	}
	.opciones > li:hover {
		transform: translateY(-4px);
		border-color: var(--color-acento);
		box-shadow: var(--sombra);
	}
	.opciones > li:hover :global(.circulo) {
		background: var(--color-acento);
		color: #fff;
	}
	.opciones h3 {
		margin: 1.25rem 0 0.5rem;
		font-size: 1.75rem;
	}
	.opciones p {
		margin: 0;
		color: var(--color-texto-suave);
	}
	.enlaces-camino {
		display: grid;
		justify-items: start;
		gap: 0.75rem;
		margin: auto 0 0;
		padding: 1.5rem 0 0;
		list-style: none;
	}
	.aviso {
		margin: 1.25rem 0 0;
		padding: 0.9rem 1.25rem;
		border-left: 3px solid var(--color-realce);
		border-radius: 0 var(--radio) var(--radio) 0;
		background: var(--color-acento-suave);
		font-size: 0.9375rem;
		color: var(--color-texto);
	}

	/* ---------- Quiénes somos ---------- */
	.quienes,
	.membresia,
	.red {
		display: grid;
