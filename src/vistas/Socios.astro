---
// Área de socios. Muestra, según la sesión y la página: el ingreso, el panel del socio, "Mi cuenta",
// "¿Olvidaste tu contraseña?" o "Crea tu contraseña". Qué se muestra lo decide el servidor (src/lib/area-socios.ts):
// sin sesión válida, esta página nunca recibe datos de socios. Queda fuera de Google (noindex y robots.txt).
import Biblioteca from '../components/socios/Biblioteca.astro';
import Cuenta from '../components/socios/Cuenta.astro';
import Ingreso from '../components/socios/Ingreso.astro';
import NuevaClave from '../components/socios/NuevaClave.astro';
import Panel from '../components/socios/Panel.astro';
import Recuperar from '../components/socios/Recuperar.astro';
import type { Idioma } from '../i18n';

interface Props {
	idioma: Idioma;
}

const estado = Astro.locals.areaSocios;
---

{
	estado && (
		<section class="banda area-socios">
			{estado.vista === 'nuevaClave' ? (
				<NuevaClave estado={estado} />
			) : estado.vista === 'recuperar' ? (
				<Recuperar estado={estado} />
			) : estado.socio && estado.vista === 'biblioteca' ? (
				<Biblioteca estado={estado} socio={estado.socio} />
			) : estado.socio && estado.vista === 'cuenta' ? (
				<Cuenta estado={estado} socio={estado.socio} />
			) : estado.socio ? (
				<Panel estado={estado} socio={estado.socio} />
			) : (
				<Ingreso estado={estado} />
			)}
		</section>
	)
}

<style is:global>
	/* Estilos comunes de los formularios y tarjetas del área de socios (componentes de src/components/socios/). */
	.area-socios .tarjeta-socios {
		max-width: 34rem;
		margin: 0 auto;
		padding: clamp(1.5rem, 5vw, 2.75rem);
		background: var(--color-tarjeta);
		border: 1px solid var(--color-borde);
		border-radius: var(--radio);
		border-start-start-radius: 2rem;
		box-shadow: var(--sombra);
	}
	.area-socios .tarjeta-socios + .tarjeta-socios {
		margin-top: 1.5rem;
	}
	.area-socios h2 {
		margin: 0 0 0.5rem;
	}
	.area-socios .bajada {
		margin: 0 0 1.5rem;
		color: var(--color-texto-suave);
	}
	.area-socios form {
		display: grid;
		gap: 1.1rem;
	}
	.area-socios .campo {
		display: grid;
		gap: 0.3rem;
	}
	.area-socios label {
		font-size: 0.875rem;
		font-weight: 600;
	}
	.area-socios input:not([type='checkbox']) {
		font: inherit;
		width: 100%;
		min-height: 48px;
		padding: 0.6rem 0.8rem;
		border: 1px solid var(--color-borde);
		border-radius: var(--radio);
		background: #fff;
		transition:
			border-color 0.2s,
			box-shadow 0.2s;
	}
	.area-socios input:focus {
		border-color: var(--color-acento);
		box-shadow: 0 0 0 3px var(--color-acento-suave);
		outline: none;
	}
	.area-socios input[aria-invalid='true'] {
		border: 2px solid #a40000;
	}
	.area-socios .ayuda {
		margin: 0;
		font-size: 0.875rem;
		color: var(--color-texto-suave);
	}
	.area-socios .casilla {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 400;
	}
	.area-socios .casilla input {
		width: 1.2rem;
		height: 1.2rem;
		accent-color: var(--color-acento);
	}
	.area-socios form .boton {
		justify-self: start;
		cursor: pointer;
	}
	.area-socios .mensaje {
		margin: 0 0 1.25rem;
		padding: 0.8rem 1rem;
		border-radius: var(--radio);
		font-weight: 700;
	}
	.area-socios .mensaje-error {
		border: 2px solid #a40000;
		color: #a40000;
		background: #fff;
	}
	.area-socios .mensaje-exito {
		border: 2px solid var(--color-acento);
		color: var(--color-acento-hover);
		background: var(--color-acento-suave);
	}
	.area-socios .enlaces {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin: 1.5rem 0 0;
		font-size: 0.9375rem;
	}
	.area-socios .pie-tarjeta {
		margin: 1.75rem 0 0;
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-borde);
		font-size: 0.9375rem;
		color: var(--color-texto-suave);
	}
</style>
