---
// Listado: próximos eventos con filtros arriba, archivo de eventos realizados por año abajo.
import ListaProximos from '../components/ListaProximos.astro';
import TarjetaEvento from '../components/TarjetaEvento.astro';
import { obtenerEventosPublicos, yaPaso } from '../lib/contenido';
import { t, type Idioma } from '../i18n';

interface Props {
	idioma: Idioma;
}

const { idioma } = Astro.props;
const textos = t(idioma);
const ev = textos.eventos;
const eventos = await obtenerEventosPublicos(idioma);
const proximos = eventos.filter((e) => !yaPaso(e));
const pasados = eventos.filter((e) => yaPaso(e)).reverse();

const porAnio = new Map<number, typeof pasados>();
for (const evento of pasados) {
	const anio = evento.datos.inicio.getFullYear();
	porAnio.set(anio, [...(porAnio.get(anio) ?? []), evento]);
}

// Solo se ofrecen como filtro los tipos y modalidades que existen entre los próximos.
const tipos = [...new Set(proximos.map((e) => e.datos.tipo))];
const modalidades = [...new Set(proximos.flatMap((e) => e.datos.modalidad ?? []))];
---

<h1>{textos.nav.eventos}</h1>

<section aria-labelledby="titulo-proximos">
	<h2 id="titulo-proximos">{ev.proximos}</h2>

	{
		proximos.length > 1 && (
			<form class="filtros" data-filtros hidden aria-label={ev.filtros}>
				<label>
					{ev.tipo}
					<select name="tipo">
						<option value="">{ev.todos}</option>
						{tipos.map((tipo) => (
							<option value={tipo}>{ev.tipos[tipo]}</option>
						))}
					</select>
				</label>
				<label>
					{ev.modalidad}
					<select name="modalidad">
						<option value="">{ev.todos}</option>
						{modalidades.map((modalidad) => (
							<option value={modalidad}>{ev.modalidades[modalidad]}</option>
						))}
					</select>
				</label>
				<p class="sin-resultados" data-sin-resultados hidden role="status">
					{ev.sinResultados}
				</p>
			</form>
		)
	}

	<ListaProximos eventos={proximos} idioma={idioma} />
</section>

{
	pasados.length > 0 && (
		<section aria-labelledby="titulo-realizados">
			<h2 id="titulo-realizados">{ev.realizados}</h2>
			{[...porAnio].map(([anio, lista]) => (
				<>
					<h3>{anio}</h3>
					<ul class="archivo">
						{lista.map((evento) => (
							<li>
								<TarjetaEvento evento={evento} idioma={idioma} nivel="h3" />
							</li>
						))}
					</ul>
				</>
			))}
		</section>
	)
}

<p class="suscripciones">
	<a href="/eventos.ics">{ev.suscribirse}</a> · <a href={`/${idioma}/eventos.xml`}>{ev.rss}</a>
</p>

<script>
	// Filtros por tipo y modalidad. Sin JavaScript no se muestran y se ven todos los eventos.
	const formulario = document.querySelector<HTMLFormElement>('[data-filtros]');
	if (formulario) {
		formulario.hidden = false;
		const aplicar = () => {
			const datos = new FormData(formulario);
			const tipo = datos.get('tipo');
			const modalidad = datos.get('modalidad');
			const tarjetas = document.querySelectorAll<HTMLElement>('[data-lista-proximos] [data-tipo]');
			let visibles = 0;
			for (const tarjeta of tarjetas) {
				const coincide = (!tipo || tarjeta.dataset.tipo === tipo) && (!modalidad || tarjeta.dataset.modalidad === modalidad);
				tarjeta.closest('li')!.hidden = !coincide;
				if (coincide) visibles++;
			}
			formulario.querySelector<HTMLElement>('[data-sin-resultados]')!.hidden = visibles > 0;
		};
		formulario.addEventListener('change', aplicar);
	}
</script>

<style>
	.filtros {
		display: flex;
		flex-wrap: wrap;
		gap: var(--espacio);
		align-items: end;
		margin-bottom: var(--espacio);
	}
	label {
		display: grid;
		gap: 0.25rem;
		font-weight: 700;
	}
	select {
		min-height: 44px;
		font: inherit;
	}
	.archivo {
		list-style: none;
		padding: 0;
		display: grid;
		gap: var(--espacio);
	}
	.suscripciones {
		margin-top: calc(var(--espacio) * 2);
		font-size: 0.9375rem;
	}
	/* Divisiones claras entre próximos, realizados y suscripciones. */
	section + section,
	.suscripciones {
		margin-top: calc(var(--espacio) * 3);
		padding-top: calc(var(--espacio) * 2);
		border-top: 1px solid var(--color-division);
	}
</style>
