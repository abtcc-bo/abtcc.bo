---
// Listado: próximos eventos con filtros arriba, archivo de eventos realizados por año abajo.
import ListaProximos from '../components/ListaProximos.astro';
import TarjetaDestacada from '../components/TarjetaDestacada.astro';
import TarjetaEvento from '../components/TarjetaEvento.astro';
import { obtenerEventosPublicos, yaPaso } from '../lib/contenido';
import { ruta, t, type Idioma } from '../i18n';

interface Props {
	idioma: Idioma;
}

const { idioma } = Astro.props;
const textos = t(idioma);
const ev = textos.eventos;
const eventos = await obtenerEventosPublicos(idioma);
const proximos = eventos.filter((e) => !yaPaso(e));
const pasados = eventos.filter((e) => yaPaso(e)).reverse();
const destacado = proximos.find((e) => e.datos.destacado);

const porAnio = new Map<number, typeof pasados>();
for (const evento of pasados) {
	const anio = evento.datos.inicio.getFullYear();
	porAnio.set(anio, [...(porAnio.get(anio) ?? []), evento]);
}

// Solo se ofrecen como filtro los tipos y modalidades que existen entre los próximos.
const tipos = [...new Set(proximos.map((e) => e.datos.tipo))];
const modalidades = [...new Set(proximos.flatMap((e) => e.datos.modalidad ?? []))];
---

{
	destacado && (
		<section class="banda destacado" aria-label={textos.destacado.etiqueta}>
			<p class="antetitulo">{textos.destacado.etiqueta}</p>
			<TarjetaDestacada evento={destacado} idioma={idioma} forma="horizontal" />
		</section>
	)
}

<section class="banda proximos" aria-labelledby="titulo-proximos">
	<div class="cabecera-seccion">
		<h2 id="titulo-proximos">{ev.proximos}</h2>

	{
		proximos.length > 1 && (
			<form class="filtros" data-filtros hidden aria-label={ev.filtros}>
				<label>
					{ev.tipo}
					<select name="tipo">
						<option value="">{ev.todos}</option>
						{tipos.map((tipo) => (
							<option value={tipo}>{ev.tipos[tipo]}</option>
						))}
					</select>
				</label>
				<label>
					{ev.modalidad}
					<select name="modalidad">
						<option value="">{ev.todos}</option>
						{modalidades.map((modalidad) => (
							<option value={modalidad}>{ev.modalidades[modalidad]}</option>
						))}
					</select>
				</label>
				<p class="sin-resultados" data-sin-resultados hidden role="status">
					{ev.sinResultados}
				</p>
			</form>
		)
	}
	</div>

	<ListaProximos eventos={proximos} idioma={idioma} />
</section>

{
	pasados.length > 0 && (
		<section class="banda banda-clara" aria-labelledby="titulo-realizados">
			<h2 id="titulo-realizados">{ev.realizados}</h2>
			{[...porAnio].map(([anio, lista]) => (
				<>
					<h3>{anio}</h3>
					<ul class="archivo">
						{lista.map((evento) => (
							<li>
								<TarjetaEvento evento={evento} idioma={idioma} nivel="h3" />
							</li>
						))}
					</ul>
				</>
			))}
		</section>
	)
}

<section class="banda banda-azul miembros" aria-labelledby="titulo-miembros">
	<div>
		<p class="antetitulo">{ev.miembrosAntetitulo}</p>
		<h2 id="titulo-miembros">{ev.miembrosTitulo}</h2>
	</div>
	<a class="boton boton-dorado" href={ruta('membresia', idioma)}>
		{ev.miembrosBoton} <span class="flecha" aria-hidden="true">→</span>
	</a>
</section>

<script>
	// Filtros por tipo y modalidad. Sin JavaScript no se muestran y se ven todos los eventos.
	const formulario = document.querySelector<HTMLFormElement>('[data-filtros]');
	if (formulario) {
		formulario.hidden = false;
		const aplicar = () => {
			const datos = new FormData(formulario);
			const tipo = datos.get('tipo');
			const modalidad = datos.get('modalidad');
			const tarjetas = document.querySelectorAll<HTMLElement>('[data-lista-proximos] [data-tipo]');
			let visibles = 0;
			for (const tarjeta of tarjetas) {
				const coincide = (!tipo || tarjeta.dataset.tipo === tipo) && (!modalidad || tarjeta.dataset.modalidad === modalidad);
				tarjeta.closest('li')!.hidden = !coincide;
				if (coincide) visibles++;
			}
			formulario.querySelector<HTMLElement>('[data-sin-resultados]')!.hidden = visibles > 0;
		};
		formulario.addEventListener('change', aplicar);
	}
</script>

<style>
	.destacado {
		padding-bottom: 2rem;
	}
	.destacado .antetitulo {
		margin-bottom: 1.25rem;
	}
	.cabecera-seccion {
		margin-bottom: 1.5rem;
	}
	.cabecera-seccion h2 {
		margin: 0;
	}
	.filtros {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		align-items: end;
	}
	label {
		display: grid;
		gap: 0.25rem;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-texto-suave);
	}
	select {
		min-width: 10rem;
		min-height: 44px;
		padding-inline: 0.75rem;
		border: 1px solid var(--color-borde);
		border-radius: var(--radio);
		background: var(--color-tarjeta);
		font: inherit;
		font-size: 0.9375rem;
		letter-spacing: 0;
		text-transform: none;
		color: var(--color-texto);
	}
	.sin-resultados {
		flex-basis: 100%;
		margin: 0;
	}
	.archivo {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
	}
	.miembros {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		margin-bottom: -3rem;
	}
	.miembros h2 {
		max-width: 32rem;
		margin: 0.75rem 0 0;
	}
</style>
