---
// Página completa de un evento (debajo de su cabecera, CabeceraEvento.astro). Con `programa`, la arma
// EventoConPrograma.astro; si no: ficha, inscripción, descripción,
// galería, preguntas, calendario y compartir; al final, con inscripción
// abierta, la banda "Reserva tu lugar". Con `tema: navidad`, todo el cuerpo lleva fondo navideño (.fondo-navidad).
import { Image, getImage } from 'astro:assets';
import { getEntries, render } from 'astro:content';
import CierreEvento from '../components/CierreEvento.astro';
import EventoConPrograma from './EventoConPrograma.astro';
import FormularioPreinscripcion from '../components/FormularioPreinscripcion.astro';
import GaleriaEvento from '../components/GaleriaEvento.astro';
import JsonLd from '../components/JsonLd.astro';
import PonentesEvento from '../components/PonentesEvento.astro';
import ProgramaEvento from '../components/ProgramaEvento.astro';
import { formatearFecha, formato, t, type Idioma } from '../i18n';
import { costoVigente, datosEstructurados, enlaceGoogleCalendar, fechaDelEvento, horario, inscripcionAbierta, isoBolivia, ponentesDelPrograma, textoCosto } from '../lib/eventos';
import { yaPaso, type Evento } from '../lib/contenido';

interface Props {
	evento: Evento;
	idioma: Idioma;
}

const { evento, idioma } = Astro.props;
const textos = t(idioma);
const ev = textos.eventos;
const { datos } = evento;
const { titulo, dirigido_a, preguntas, programa } = evento.texto.data;
const { Content } = await render(evento.texto);
const facilitadores = await getEntries(datos.facilitadores);
// Para Google: quienes exponen, de la lista de facilitadores o del programa.
const nombresPonentes = facilitadores.length ? facilitadores.map((p) => p.data.nombre) : ponentesDelPrograma(evento).map((a) => a.ponente!);
const abierta = inscripcionAbierta(evento);
const pasado = yaPaso(evento);
const navidad = datos.tema === 'navidad';
const conPreinscripcion = datos.preinscripcion && datos.estado === 'programado' && !pasado;
const sitio = Astro.site!;
const urlPagina = new URL(Astro.url.pathname, sitio).href;
const imagenRedes = datos.imagen ? new URL((await getImage({ src: datos.imagen, width: 1200 })).src, sitio).href : undefined;
// Para eventos en línea: la hora de inicio en la zona del visitante (la completa el script de abajo), debajo del
// horario o de las sesiones.
const conHoraLocal = !datos.por_confirmar && datos.modalidad !== 'presencial';

const compartir = [
	{ nombre: 'WhatsApp', url: `https://wa.me/?text=${encodeURIComponent(`${titulo} ${urlPagina}`)}` },
	{ nombre: 'LinkedIn', url: `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(urlPagina)}` },
	{ nombre: 'Facebook', url: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(urlPagina)}` },
];
---

{programa.length > 0 ? (
<EventoConPrograma evento={evento} idioma={idioma} />
) : (
<div class:list={['cuerpo-evento', { 'banda fondo-navidad': navidad }]}>
<article class="evento">
	<dl class="ficha">
		<dt>{ev.fecha}</dt>
		<dd>{fechaDelEvento(evento, idioma)}</dd>

		{
			// Con sesiones, el horario de cada día va en "Sesiones" y esta fila se omite.
			datos.sesiones.length === 0 && (
				<>
					<dt>{ev.horario}</dt>
					<dd>
						{datos.por_confirmar || datos.horario_por_confirmar ? ev.porConfirmar : horario(datos.inicio, datos.fin, idioma)}
						{
							conHoraLocal && (
								<span class="hora-local" data-hora-local data-inicio={isoBolivia(datos.inicio)} hidden>
									{ev.tuHoraLocal} <span data-valor />
								</span>
							)
						}
					</dd>
				</>
			)
		}

		{
			datos.sesiones.length > 0 && (
				<>
					<dt>{ev.sesiones}</dt>
					<dd>
						<ol>
							{datos.sesiones.map((s) => (
								<li>
									{formatearFecha(s.inicio, idioma)}, {horario(s.inicio, s.fin, idioma)}
								</li>
							))}
						</ol>
						{
							conHoraLocal && (
								<span class="hora-local" data-hora-local data-inicio={isoBolivia(datos.inicio)} hidden>
									{ev.tuHoraLocal} <span data-valor />
								</span>
							)
						}
					</dd>
				</>
			)
		}

		<dt>{ev.modalidad}</dt>
		<dd>{datos.modalidad ? ev.modalidades[datos.modalidad] : ev.porConfirmar}</dd>

		{
			datos.lugar && (
				<>
					<dt>{ev.lugar}</dt>
					<dd>
						{[datos.lugar.nombre, datos.lugar.direccion, datos.lugar.ciudad].filter(Boolean).join(', ')}
						{datos.lugar.mapa && (
							<>
								{' '}
								· <a href={datos.lugar.mapa} rel="noopener">{ev.verMapa}</a>
							</>
						)}
					</dd>
				</>
			)
		}

		{
			datos.modalidad && datos.modalidad !== 'presencial' && (
				<>
					<dt>{ev.plataforma}</dt>
					<dd>
						{datos.plataforma ?? ev.modalidades.online}. {ev.enlaceInscritos}
					</dd>
				</>
			)
		}

		{!(pasado && !datos.gratuito && datos.costos.length === 0) && (
		<>
		<dt>{ev.costos}</dt>
		<dd>
			{
				datos.gratuito ? (
					ev.gratuito
				) : datos.costos.length === 0 ? (
					ev.porConfirmar
				) : (
					<ul class="costos">
						{datos.costos.filter((c) => pasado || costoVigente(c)).map((c) => {
							const { monto, leyenda } = textoCosto(c, idioma);
							return (
								<li data-hasta={c.hasta?.toISOString()}>
									<strong>{monto}</strong> · {leyenda}
								</li>
							);
						})}
					</ul>
				)
			}
		</dd>
		</>
		)}

		{
			datos.cupos && (
				<>
					<dt>{ev.cupos}</dt>
					<dd>{formato(ev.cuposValor, { n: datos.cupos })}</dd>
				</>
			)
		}

		{
			datos.certificacion && (
				<>
					<dt>{ev.certificacion}</dt>
					<dd>
						{[datos.certificacion.horas && formato(ev.horas, { n: datos.certificacion.horas }), datos.certificacion.aval && formato(ev.aval, { aval: datos.certificacion.aval })]
							.filter(Boolean)
							.join('. ')}
					</dd>
				</>
			)
		}

		{
			dirigido_a && (
				<>
					<dt>{ev.dirigidoA}</dt>
					<dd>{dirigido_a}</dd>
				</>
			)
		}
	</dl>

	<div class="inscripcion">
		{
			abierta && datos.inscripcion ? (
				<>
					<a class="boton" href={datos.inscripcion.url} rel="noopener">
						{textos.comun.inscribirme}
					</a>
					{datos.inscripcion.limite && <span>{formato(ev.limite, { fecha: formatearFecha(datos.inscripcion.limite, idioma) })}</span>}
				</>
			) : (
				datos.inscripcion && <span>{ev.cerradas}</span>
			)
		}
	</div>

	<div class="descripcion">
		<Content />
	</div>

	{conPreinscripcion && <FormularioPreinscripcion evento={evento} idioma={idioma} />}

	{programa.length > 0 && <ProgramaEvento evento={evento} idioma={idioma} />}

	{
		programa.length > 0 && (
			<section class="ponentes" aria-labelledby="titulo-ponentes">
				<h2 id="titulo-ponentes">{ev.ponentes}</h2>
				<PonentesEvento evento={evento} idioma={idioma} />
			</section>
		)
	}

	{datos.galeria.length > 0 && <GaleriaEvento fotos={datos.galeria} idioma={idioma} />}

	{
		facilitadores.length > 0 && programa.length === 0 && (
			<section aria-labelledby="titulo-facilitadores">
				<h2 id="titulo-facilitadores">{ev.facilitadores}</h2>
				<ul class="facilitadores">
					{facilitadores.map((persona) => (
						<li>
							{persona.data.foto ? (
								<Image src={persona.data.foto} alt="" width={120} height={120} class="foto" />
							) : (
								<span class="foto sin-foto" aria-hidden="true">
									{persona.data.nombre
										.split(' ')
										.slice(0, 2)
										.map((parte) => parte[0])
										.join('')}
								</span>
							)}
							<strong>{persona.data.nombre}</strong>
							{persona.data.titulo_profesional && <span class="titulo">{persona.data.titulo_profesional}</span>}
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		preguntas.length > 0 && (
			<section aria-labelledby="titulo-preguntas">
				<h2 id="titulo-preguntas">{ev.preguntas}</h2>
				{preguntas.map((p) => (
					<details>
						<summary>{p.pregunta}</summary>
						<p>{p.respuesta}</p>
					</details>
				))}
			</section>
		)
	}

	{
		datos.estado !== 'cancelado' && !datos.por_confirmar && !pasado && (
			<section aria-labelledby="titulo-calendario">
				<h2 id="titulo-calendario">{ev.calendario}</h2>
				<ul class="en-linea">
					<li>
						<a href={enlaceGoogleCalendar(evento, idioma, sitio)} rel="noopener">
							{ev.googleCalendar}
						</a>
					</li>
					<li>
						<a href={`/${idioma}/calendario/${evento.slug}.ics`} download>
							{ev.descargarIcs}
						</a>
					</li>
				</ul>
			</section>
		)
	}

	<section aria-labelledby="titulo-compartir">
		<h2 id="titulo-compartir">{ev.compartir}</h2>
		<ul class="en-linea">
			{
				compartir.map((red) => (
					<li>
						<a href={red.url} rel="noopener" target="_blank">
							{red.nombre}
						</a>
					</li>
				))
			}
		</ul>
	</section>
</article>
{abierta && datos.inscripcion && <CierreEvento evento={evento} idioma={idioma} />}
</div>
)}

{
	// Sin fecha exacta no se declara el evento a Google (pide fecha y hora reales).
	!datos.por_confirmar && (
		<JsonLd datos={datosEstructurados(evento, idioma, sitio, { facilitadores: nombresPonentes, imagen: imagenRedes })} />
	)
}

<script>
	// Para eventos en línea: si el visitante está en otra zona horaria, muestra la hora del evento en la suya.
	const elemento = document.querySelector<HTMLElement>('[data-hora-local]');
	if (elemento) {
		const inicio = new Date(elemento.dataset.inicio!);
		if (inicio.getTimezoneOffset() !== 240) {
			const formato = new Intl.DateTimeFormat(document.documentElement.lang, { dateStyle: 'long', timeStyle: 'short', timeZoneName: 'short' });
			elemento.querySelector('[data-valor]')!.textContent = formato.format(inicio);
			elemento.hidden = false;
		}
	}
	// La página se arma al publicar: un precio de preventa que ya venció se oculta en el navegador.
	for (const precio of document.querySelectorAll<HTMLElement>('[data-hasta]')) {
		if (Date.parse(precio.dataset.hasta!) < Date.now()) precio.hidden = true;
	}
</script>

<style>
	.evento {
		max-width: 56rem;
		padding-top: clamp(2rem, 5vw, 3rem);
	}
	/* En computadora, todo un poco más grande para leer con comodidad. */
	@media (min-width: 64rem) {
		.evento {
			font-size: 1.15rem;
		}
		.evento dt {
			font-size: 0.875rem;
		}
	}
	/* Navidad: el artículo va centrado sobre el fondo festivo, con la ficha en tarjeta de borde vino y dorado. */
	.fondo-navidad {
		padding-top: 0;
	}
	.fondo-navidad .evento {
		margin-inline: auto;
	}
	.fondo-navidad .ficha {
		border-color: #ecd9b0;
		border-top-color: #8a1a2c;
		background: #fffdf8;
		box-shadow: var(--sombra);
	}
	.fondo-navidad .inscripcion {
		background: transparent;
	}
	.fondo-navidad h2 {
		color: #7a1526;
	}
	.fondo-navidad details {
		margin-top: 0.6rem;
		padding: 0.25rem 1.25rem;
		border: 1px solid #ecd9b0;
		border-radius: var(--radio);
		background: #fffdf8;
	}
	.fondo-navidad .ponentes :global(li) {
		padding: 1rem;
		border: 1px solid #ecd9b0;
		border-radius: var(--radio);
		background: #fffdf8;
	}
	.evento > :global(.programa),
	.ponentes {
		margin-top: 3.5rem;
	}
	.ficha {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: 0.6rem 1.5rem;
		padding: 1.5rem;
		background: var(--color-superficie);
		border: 1px solid var(--color-borde);
		border-top: 4px solid var(--color-acento);
		border-radius: var(--radio);
	}
	dt {
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-family: var(--fuente-interfaz);
		color: var(--color-texto-suave);
		padding-top: 0.2rem;
	}
	dd {
		margin: 0;
	}
	.ficha ul,
	.ficha ol {
		margin: 0;
		padding-left: 1.25rem;
	}
	.hora-local {
		display: block;
		color: var(--color-texto-suave);
	}
	.inscripcion {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--espacio);
		padding-block: var(--espacio);
		background: var(--color-fondo);
	}
	.inscripcion:empty {
		display: none;
	}
	.en-linea,
	/* Ponentes: foto redonda (o iniciales), nombre y título. */
	.facilitadores {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(9rem, 45%), 1fr));
		gap: 1.5rem 1rem;
		list-style: none;
		padding: 0;
	}
	.facilitadores li {
		display: grid;
		justify-items: center;
		gap: 0.2rem;
		text-align: center;
	}
	.foto {
		width: 5.5rem;
		height: 5.5rem;
		margin-bottom: 0.5rem;
		border-radius: 50%;
		object-fit: cover;
		box-shadow: 0 0 0 3px var(--color-tarjeta), 0 0 0 4px var(--color-borde);
	}
	.sin-foto {
		display: grid;
		place-items: center;
		background: var(--color-verde);
		font-family: var(--fuente-titulos);
		font-size: 1.75rem;
		font-style: italic;
		color: #fff;
	}
	.facilitadores strong {
		font-family: var(--fuente-titulos);
		font-size: 1.15rem;
		font-weight: 500;
		line-height: 1.2;
		color: var(--color-titulos);
	}
	.facilitadores .titulo {
		font-size: 0.75rem;
		color: var(--color-texto-suave);
	}
	.en-linea {
		display: flex;
		flex-wrap: wrap;
		gap: var(--espacio);
	}
	summary {
		cursor: pointer;
		font-weight: 700;
		min-height: 44px;
		display: flex;
		align-items: center;
	}
	@media (max-width: 48rem) {
		.ficha {
			grid-template-columns: 1fr;
		}
		dd {
			margin-bottom: 0.5rem;
		}
		/* Botón de inscripción siempre a mano en el celular. */
		.inscripcion {
			position: sticky;
			bottom: 0;
			border-top: 1px solid var(--color-borde);
		}
	}
</style>
