// Configuración del Worker de Cloudflare donde se publica la web.
// Dirección gratuita: https://abtcc.abtcc-bo.workers.dev (nombre del Worker + subdominio de la cuenta).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "abtcc",
	"main": "./src/worker.ts",
	"compatibility_flags": ["nodejs_compat"],
	// Tarea diaria a las 04:00 UTC = medianoche en Bolivia (src/worker.ts → scheduled).
	"triggers": { "crons": ["0 4 * * *"] },
	// Depósito privado con los archivos de la biblioteca de socios y su catálogo (catalogo.json).
	// "remote": true hace que `npm run dev` use el depósito real (no una copia vacía); al publicar no cambia nada.
	"r2_buckets": [{ "binding": "BIBLIOTECA", "bucket_name": "abtcc-biblioteca", "remote": true }],
	"observability": { "enabled": true }
}
