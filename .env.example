# Copia este archivo como .env para pruebas locales. El .env real NUNCA se sube a GitHub.
# En producción se cargan en Cloudflare → Workers → abtcc → Settings → Variables and Secrets.
# TURNSTILE_SITE_KEY además va en Settings → Build → Variables (se usa al construir).

# Resend (envío de correos del formulario de contacto): https://resend.com → API Keys
RESEND_API_KEY=
# Cloudflare Turnstile (antispam): https://dash.cloudflare.com → Turnstile
# TURNSTILE_SITE_KEY ya tiene su valor en astro.config.mjs (es pública)
TURNSTILE_SECRET_KEY=
# Correo que recibe los mensajes del formulario (por defecto, el de src/datos/organizacion.ts)
CONTACTO_DESTINO=
# Supabase (registro de preinscripciones a eventos): Project Settings → API.
# SUPABASE_URL es la "Project URL"; SUPABASE_KEY es la clave pública ("publishable" o "anon"), NUNCA la secreta.
SUPABASE_URL=
SUPABASE_KEY=

