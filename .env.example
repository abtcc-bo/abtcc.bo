# Copia este archivo como .env para pruebas locales. El .env real NUNCA se sube a GitHub.
# En producción estas claves se cargan en Vercel → Project → Settings → Environment Variables.

# Resend (envío de correos del formulario de contacto): https://resend.com → API Keys
RESEND_API_KEY=
# Cloudflare Turnstile (antispam): https://dash.cloudflare.com → Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Correo que recibe los mensajes del formulario (por defecto, el de src/datos/organizacion.ts)
CONTACTO_DESTINO=

# Tarea diaria de mantenimiento (/api/mantenimiento/). CRON_SECRET: un texto largo al azar; Vercel lo envía solo.
CRON_SECRET=
# Vercel → Project → Settings → Git → Deploy Hooks → crear uno para la rama main
VERCEL_DEPLOY_HOOK_URL=
